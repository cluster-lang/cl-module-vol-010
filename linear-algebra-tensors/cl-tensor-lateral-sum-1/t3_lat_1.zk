// cl-tensor-lateral-sum-1: 3x3x3 Tensor Lateral Slice Sum Stage 1
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn tensor_lateral_sum_1(t: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 27:
        s = s + t[i] * 1.0
        i = i + 3
    return s
