// cl-tensor-kronecker-diag-stage-19: Test Suite
import "../krn_d_19.zk"

fn test_run():
    res := kronecker_diag_19(2.0, 3.0)
    diff := res - 114.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-tensor-kronecker-diag-stage-19!")
