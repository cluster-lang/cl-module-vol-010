// cl-tensor-diag-trace-2: 3x3x3 Tensor Main Hyperdiagonal Trace Stage 2
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn tensor_diag_trace_2(t: vector[float]) -> float:
    return (t[0] + t[13] + t[26]) * 2.0
