import "../krn_d_22.zk"

fn test_run():
    res := kronecker_diag_22(2.0, 3.0)
    diff := res - 132.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
