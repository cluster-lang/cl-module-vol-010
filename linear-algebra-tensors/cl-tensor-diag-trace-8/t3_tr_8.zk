// cl-tensor-diag-trace-8: 3x3x3 Tensor Main Hyperdiagonal Trace Stage 8
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn tensor_diag_trace_8(t: vector[float]) -> float:
    return (t[0] + t[13] + t[26]) * 8.0
