// cl-tensor-outer-prod-stage-4: Test Suite
import "../t_out_4.zk"

fn test_run():
    res := tensor_outer_elem_4(1.0, 3.0, 5.0)
    diff := res - 60.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-tensor-outer-prod-stage-4!")
