// cl-string-jaro-winkler-threshold: Test Suite
import "../jw_filter.zk"

fn test_jw_filter():
    if jw_passes_threshold(0.85, 0.80) != 1: sys_exit(1)
    if jw_passes_threshold(0.75, 0.80) != 0: sys_exit(1)
    print("test_jw_filter passed: Jaro-Winkler threshold filter verified")

fn main():
    test_jw_filter()
    print("✓ All tests passed for cl-string-jaro-winkler-threshold!")
