// cl-string-jaro-metric-score: Test Suite
import "../jaro_score.zk"

fn test_jaro_score():
    s := jaro_combine_score(1.0, 1.0, 1.0)
    diff := s - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_jaro_score passed: Jaro score combiner verified")

fn main():
    test_jaro_score()
    print("✓ All tests passed for cl-string-jaro-metric-score!")
