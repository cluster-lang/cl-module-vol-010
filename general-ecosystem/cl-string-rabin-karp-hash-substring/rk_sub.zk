// cl-string-rabin-karp-hash-substring: Rabin-Karp Substring Window Polynomial Hash
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rabin_karp_substring_hash(text: vector[int], start: int, sub_len: int, base: int, modulus: int) -> int:
    h := 0
    i := 0
    while i < sub_len:
        idx := start + i
        b := text[idx] & 255
        h = (h * base + b) % modulus
        i = i + 1
    return h
