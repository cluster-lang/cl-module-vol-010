// cl-string-rabin-karp-hash-substring: Test Suite
import "../rk_sub.zk"

fn test_rk_sub():
    t: vector[int] := [65, 66, 67, 68]
    h := rabin_karp_substring_hash(t, 1, 2, 256, 1000000007)
    if h != 16963: sys_exit(1)
    print("test_rk_sub passed: substring hash 16963 verified")

fn main():
    test_rk_sub()
    print("✓ All tests passed for cl-string-rabin-karp-hash-substring!")
