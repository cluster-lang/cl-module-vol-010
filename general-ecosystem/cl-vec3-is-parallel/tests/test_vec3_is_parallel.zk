// cl-vec3-is-parallel: Test Suite
import "../v3_par.zk"

fn test_op():
    res := vec3_is_parallel([2.0, 4.0, 6.0], [1.0, 2.0, 3.0], 0.001)
    diff := float(res) - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec3-is-parallel!")
