// cl-stat-equipartition-stage-7: Test Suite
import "../eq_en_7.zk"

fn test_run():
    res := equipartition_energy_7(100.0)
    diff := res - 483.2271
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-equipartition-stage-7!")
