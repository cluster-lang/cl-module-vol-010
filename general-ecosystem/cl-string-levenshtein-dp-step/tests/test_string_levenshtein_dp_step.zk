// cl-string-levenshtein-dp-step: Test Suite
import "../lev_dp.zk"

fn test_lev_dp():
    cost_match := lev_step_cost(1, 1, 0, 65, 65)
    if cost_match != 0: sys_exit(1)
    cost_sub := lev_step_cost(1, 1, 0, 65, 66)
    if cost_sub != 1: sys_exit(1)
    print("test_lev_dp passed: Levenshtein DP step verified")

fn main():
    test_lev_dp()
    print("✓ All tests passed for cl-string-levenshtein-dp-step!")
