// cl-vec4-distance-squared: Test Suite
import "../vec4_dist_sq.zk"

fn test_v4_dist_sq():
    a: vector[float] := [1.0, 2.0, 3.0, 4.0]
    b: vector[float] := [2.0, 4.0, 5.0, 6.0]
    // 1 + 4 + 4 + 4 = 13.0
    res := vec4_distance_squared(a, b)
    diff := res - 13.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v4_dist_sq passed")

fn main():
    test_v4_dist_sq()
    print("✓ All tests passed for cl-vec4-distance-squared!")
