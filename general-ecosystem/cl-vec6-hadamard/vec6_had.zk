// cl-vec6-hadamard: 6D Vector Component-wise Multiplication
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec6_hadamard(out: vector[float], a: vector[float], b: vector[float]):
    i := 0
    while i < 6:
        out[i] = a[i] * b[i]
        i = i + 1
