// cl-stat-maxwell-speed-sq-stage-23: Test Suite
import "../mb_sp_23.zk"

fn test_run():
    res := maxwell_speed_factor_23(10.0)
    diff := res - 2300.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-maxwell-speed-sq-stage-23!")
