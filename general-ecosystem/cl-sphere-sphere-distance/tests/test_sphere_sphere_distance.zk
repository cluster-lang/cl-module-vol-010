// cl-sphere-sphere-distance: Test Suite
import "../sphere_dist.zk"

fn test_sphere_dist():
    c1: vector[float] := [0.0, 0.0, 0.0]
    c2: vector[float] := [10.0, 0.0, 0.0]
    d := sphere_sphere_surface_distance(c1, 2.0, c2, 3.0)
    // Center dist = 10, r1 + r2 = 5 -> surface distance = 5.0
    diff := d - 5.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_sphere_dist passed: sphere surface distance 5.0 verified")

fn main():
    test_sphere_dist()
    print("✓ All tests passed for cl-sphere-sphere-distance!")
