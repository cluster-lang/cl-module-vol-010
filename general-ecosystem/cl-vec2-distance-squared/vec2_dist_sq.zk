// cl-vec2-distance-squared: 2D Squared Euclidean Distance
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_distance_squared(a: vector[float], b: vector[float]) -> float:
    dx := a[0] - b[0]
    dy := a[1] - b[1]
    return dx * dx + dy * dy
