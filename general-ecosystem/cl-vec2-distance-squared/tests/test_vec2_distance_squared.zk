// cl-vec2-distance-squared: Test Suite
import "../vec2_dist_sq.zk"

fn test_v2_dist_sq():
    a: vector[float] := [1.0, 2.0]
    b: vector[float] := [4.0, 6.0]
    // dx=3, dy=4 -> 9+16 = 25.0
    res := vec2_distance_squared(a, b)
    diff := res - 25.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_dist_sq passed")

fn main():
    test_v2_dist_sq()
    print("✓ All tests passed for cl-vec2-distance-squared!")
