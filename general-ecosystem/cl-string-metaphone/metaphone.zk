// cl-string-metaphone: Deduplicated Adjacent Phonetic Compressor
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn collapse_duplicates(s: string) -> string:
    slen := len(s)
    if slen == 0: return ""
    res := ""
    res = res + chr(byte_at(s, 0))
    i := 1
    while i < slen:
        if byte_at(s, i) != byte_at(s, i - 1):
            res = res + chr(byte_at(s, i))
        i = i + 1
    return res
