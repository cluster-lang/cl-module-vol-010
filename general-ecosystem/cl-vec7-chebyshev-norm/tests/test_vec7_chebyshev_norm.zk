// cl-vec7-chebyshev-norm: Test Suite
import "../v7_cheb.zk"

fn test_run():
    res := vec7_chebyshev([-1.0, 2.0, -3.0, 8.0, -5.0, 6.0, -7.0])
    diff := res - 8.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-vec7-chebyshev-norm!")
