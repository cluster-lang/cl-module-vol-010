// cl-stat-metric-stage-9: Test Suite
import "../sm_st_9.zk"

fn test_run():
    res := stat_metric_stage_9(1.0)
    diff := res - 9.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-metric-stage-9!")
