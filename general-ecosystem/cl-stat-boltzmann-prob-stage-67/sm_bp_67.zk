// cl-stat-boltzmann-prob-stage-67: Boltzmann State Probability Ratio Stage 67
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn boltzmann_ratio_67(e1: float, e2: float, kt: float) -> float:
    return (1.0 - (e1 - e2) / kt) * 67.0
