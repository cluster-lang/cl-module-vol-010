// cl-stat-boltzmann-entropy-stage-26: Test Suite
import "../boltz_s_26.zk"

fn test_run():
    res := boltzmann_entropy_factor_26(10.0)
    diff := res - 358.9687
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-entropy-stage-26!")
