// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn canberra_3d(u: vector[float], v: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 3:
        num := u[i] - v[i]
        if num < 0.0: num = 0.0 - num
        denom := u[i] + v[i]
        if denom > 0.000001: s = s + num / denom
        i = i + 1
    return s
