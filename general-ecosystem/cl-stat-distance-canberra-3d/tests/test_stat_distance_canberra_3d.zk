// cl-stat-distance-canberra-3d: Test Suite
import "../dist_canb3.zk"

fn test_run():
    res := canberra_3d([1.0, 2.0, 3.0], [1.0, 2.0, 3.0])
    diff := res - 0.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-distance-canberra-3d!")
