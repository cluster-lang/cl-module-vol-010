// cl-triangle3d-circumcenter: Test Suite
import "../tri_circum.zk"

fn test_tri_circum():
    // Right triangle at (0,0), (4,0), (0,4) has circumcenter at hypotenuse midpoint (2,2)
    out: vector[float] := []
    triangle2d_circumcenter(out, 0.0, 0.0, 4.0, 0.0, 0.0, 4.0)
    diff0 := out[0] - 2.0
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    diff1 := out[1] - 2.0
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    print("test_tri_circum passed: circumcenter (2,2) verified")

fn main():
    test_tri_circum()
    print("✓ All tests passed for cl-triangle3d-circumcenter!")
