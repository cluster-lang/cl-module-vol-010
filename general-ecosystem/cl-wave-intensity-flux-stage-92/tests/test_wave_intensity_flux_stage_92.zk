// cl-wave-intensity-flux-stage-92: Test Suite
import "../ac_int_92.zk"

fn test_run():
    res := wave_intensity_92(20.0, 400.0)
    diff := res - 92.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-intensity-flux-stage-92!")
