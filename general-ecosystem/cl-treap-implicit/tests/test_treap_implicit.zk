// cl-treap-implicit: Test Suite
import "../treap_implicit.zk"

fn test_treap():
    sizes: vector[int] := [0, 0, 1, 1]
    left: vector[int] := [0, 2, 0, 0]
    right: vector[int] := [0, 3, 0, 0]
    treap_update_size(sizes, left, right, 1)
    if sizes[1] != 3: sys_exit(1)
    print("test_treap passed: subtree size update verified")

fn main():
    test_treap()
    print("✓ All tests passed for cl-treap-implicit!")
