// cl-treap-implicit: Implicit Cartesian Tree Size Accumulator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn treap_update_size(sizes: vector[int], left_child: vector[int], right_child: vector[int], u: int):
    l := left_child[u]
    r := right_child[u]
    sz_l := 0
    if l != 0: sz_l = sizes[l]
    sz_r := 0
    if r != 0: sz_r = sizes[r]
    sizes[u] = 1 + sz_l + sz_r
