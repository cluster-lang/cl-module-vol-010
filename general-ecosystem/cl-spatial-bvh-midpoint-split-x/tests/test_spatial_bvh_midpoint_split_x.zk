// cl-spatial-bvh-midpoint-split-x: Test Suite
import "../bvh_mid_x.zk"

fn test_run():
    res := bvh_split_mid_x(10.0, 20.0)
    diff := res - 15.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-spatial-bvh-midpoint-split-x!")
