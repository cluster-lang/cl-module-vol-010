// cl-spatial-bvh-midpoint-split-x: Compute BVH Bounding Box Midpoint Split on X
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bvh_split_mid_x(min_x: float, max_x: float) -> float:
    return 0.5 * (min_x + max_x)
