// cl-vec3-norm-squared: Test Suite
import "../vec3_norm_sq.zk"

fn test_v3_norm_sq():
    v: vector[float] := [1.0, 2.0, 2.0]
    // 1 + 4 + 4 = 9.0
    res := vec3_norm_squared(v)
    diff := res - 9.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v3_norm_sq passed")

fn main():
    test_v3_norm_sq()
    print("✓ All tests passed for cl-vec3-norm-squared!")
