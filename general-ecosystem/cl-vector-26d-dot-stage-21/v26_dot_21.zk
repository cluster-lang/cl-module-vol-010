// cl-vector-26d-dot-stage-21: 26D Vector Dot Product Stage 21
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec26_dot_21(a: vector[float], b: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 26:
        s = s + a[i] * b[i]
        i = i + 1
    return s * 21.0
