// cl-sphere-triangle3d-intersect: Test Suite
import "../sph_tri.zk"

fn test_sph_tri():
    hit := sphere_triangle3d_hit(1.0, 1.0, 0.5, 1.0, 0.0, 0.0, 0.0, 10.0, 0.0, 0.0, 0.0, 10.0, 0.0)
    if hit != 1: sys_exit(1)
    miss := sphere_triangle3d_hit(1.0, 1.0, 5.0, 1.0, 0.0, 0.0, 0.0, 10.0, 0.0, 0.0, 0.0, 10.0, 0.0)
    if miss != 0: sys_exit(2)
    print("test_sph_tri passed: sphere-triangle collision verified")

fn main():
    test_sph_tri()
    print("✓ All tests passed for cl-sphere-triangle3d-intersect!")
