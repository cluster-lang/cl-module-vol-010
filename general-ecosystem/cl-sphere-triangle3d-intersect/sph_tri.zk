// cl-sphere-triangle3d-intersect: 3D Sphere to Triangle Collision Test
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sphere_triangle3d_hit(sx: float, sy: float, sz: float, radius: float, ax: float, ay: float, az: float, bx: float, by: float, bz: float, cx: float, cy: float, cz: float) -> int:
    abx := bx - ax
    aby := by - ay
    abz := bz - az
    acx := cx - ax
    acy := cy - ay
    acz := cz - az
    nx := aby * acz - abz * acy
    ny := abz * acx - abx * acz
    nz := abx * acy - aby * acx
    n_len_sq := nx * nx + ny * ny + nz * nz
    if n_len_sq == 0.0: return 0

    apx := sx - ax
    apy := sy - ay
    apz := sz - az
    dist_plane := (apx * nx + apy * ny + apz * nz)
    if dist_plane < 0.0: dist_plane = 0.0 - dist_plane

    if (dist_plane * dist_plane) <= (radius * radius * n_len_sq):
        return 1
    return 0
