// cl-vec2-chebyshev-norm: Test Suite
import "../vec2_cheb_norm.zk"

fn test_v2_cheb_norm():
    v: vector[float] := [-6.0, 4.0]
    res := vec2_chebyshev_norm(v)
    diff := res - 6.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_cheb_norm passed")

fn main():
    test_v2_cheb_norm()
    print("✓ All tests passed for cl-vec2-chebyshev-norm!")
