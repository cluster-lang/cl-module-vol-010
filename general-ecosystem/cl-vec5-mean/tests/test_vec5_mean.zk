// cl-vec5-mean: Test Suite
import "../vec5_mean.zk"

fn test_v5_mean():
    v: vector[float] := [2.0, 2.0, 2.0, 2.0, 2.0]
    res := vec5_mean(v)
    diff := res - 2.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v5_mean passed")

fn main():
    test_v5_mean()
    print("✓ All tests passed for cl-vec5-mean!")
