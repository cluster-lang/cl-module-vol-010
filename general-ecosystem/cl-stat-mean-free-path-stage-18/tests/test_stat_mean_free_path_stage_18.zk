// cl-stat-mean-free-path-stage-18: Test Suite
import "../mfp_cp_18.zk"

fn test_run():
    res := mean_free_path_comp_18(1.0, 1.0)
    diff := res - 4.0514
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
