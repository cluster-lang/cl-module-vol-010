// cl-vec4-manhattan-norm: Test Suite
import "../vec4_man_norm.zk"

fn test_v4_man_norm():
    v: vector[float] := [-1.0, 2.0, -3.0, 4.0]
    res := vec4_manhattan_norm(v)
    diff := res - 10.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v4_man_norm passed")

fn main():
    test_v4_man_norm()
    print("✓ All tests passed for cl-vec4-manhattan-norm!")
