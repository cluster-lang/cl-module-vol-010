// cl-wave-intensity-flux-stage-1: Test Suite
import "../ac_int_1.zk"

fn test_run():
    res := wave_intensity_1(20.0, 400.0)
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-intensity-flux-stage-1!")
