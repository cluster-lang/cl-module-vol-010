// cl-xxhash32-streaming: Streaming 32-bit XXHash State Machine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn rotl32(x: int, b: int) -> int:
    mask32 := 4294967295
    val := x & mask32
    return ((val << b) | (val >> (32 - b))) & mask32

fn xxh32_round(acc: int, input_val: int) -> int:
    p1 := 2654435761 // 0x9E3779B1
    p2 := 2246822519 // 0x85EBCA77
    mask32 := 4294967295
    res := (acc + ((input_val & mask32) * p2)) & mask32
    res = rotl32(res, 13)
    return (res * p1) & mask32
