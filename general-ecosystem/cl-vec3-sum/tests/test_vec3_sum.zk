// cl-vec3-sum: Test Suite
import "../vec3_sum.zk"

fn test_v3_sum():
    v: vector[float] := [10.0, 20.0, 30.0]
    res := vec3_sum(v)
    diff := res - 60.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v3_sum passed")

fn main():
    test_v3_sum()
    print("✓ All tests passed for cl-vec3-sum!")
