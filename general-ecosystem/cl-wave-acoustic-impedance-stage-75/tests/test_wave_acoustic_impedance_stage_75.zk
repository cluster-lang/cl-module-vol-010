// cl-wave-acoustic-impedance-stage-75: Test Suite
import "../ac_imp_75.zk"

fn test_run():
    res := acoustic_impedance_75(1.2, 343.0)
    diff := res - 30870.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
