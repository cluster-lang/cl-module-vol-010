// cl-stat-metric-stage-23: Test Suite
import "../sm_st_23.zk"

fn test_run():
    res := stat_metric_stage_23(1.0)
    diff := res - 23.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-metric-stage-23!")
