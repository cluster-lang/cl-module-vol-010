// cl-stat-chemical-potential-stage-32: Test Suite
import "../sm_cp_32.zk"

fn test_run():
    res := chemical_pot_32(150.0, 3.0)
    diff := res - 1600.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-chemical-potential-stage-32!")
