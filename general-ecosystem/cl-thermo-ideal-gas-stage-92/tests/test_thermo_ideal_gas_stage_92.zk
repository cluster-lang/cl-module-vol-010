// cl-thermo-ideal-gas-stage-92: Test Suite
import "../gas_pr_92.zk"

fn test_run():
    res := ideal_gas_pressure_92(1.0, 300.0, 1.0)
    diff := res - 229479.1512
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
