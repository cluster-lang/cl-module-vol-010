// cl-wave-doppler-shift-stage-79: Doppler Moving Source Frequency Factor Stage 79
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn doppler_factor_79(c_sound: float, v_source: float) -> float:
    den := c_sound - v_source
    if den <= 0.0001: return 0.0
    return (c_sound / den) * 79.0
