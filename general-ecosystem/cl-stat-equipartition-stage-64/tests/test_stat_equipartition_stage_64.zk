// cl-stat-equipartition-stage-64: Test Suite
import "../eq_en_64.zk"

fn test_run():
    res := equipartition_energy_64(100.0)
    diff := res - 4418.0768
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-equipartition-stage-64!")
