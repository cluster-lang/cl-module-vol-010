// cl-stat-mean-free-path-stage-93: Test Suite
import "../mfp_cp_93.zk"

fn test_run():
    res := mean_free_path_comp_93(1.0, 1.0)
    diff := res - 20.9324
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
