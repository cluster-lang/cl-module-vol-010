// cl-stat-boltzmann-entropy-stage-63: Test Suite
import "../boltz_s_63.zk"

fn test_run():
    res := boltzmann_entropy_factor_63(10.0)
    diff := res - 869.8089
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-entropy-stage-63!")
