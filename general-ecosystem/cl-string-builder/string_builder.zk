// cl-string-builder: Pure Cluster String Chunk Accumulator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

model StringBuilder:
    chunks: vector[string]

fn sb_new() -> StringBuilder:
    c: vector[string] := []
    return StringBuilder(c)

fn sb_append(sb: StringBuilder, s: string):
    sb.chunks.push(s)

fn sb_build(sb: StringBuilder) -> string:
    res := ""
    i := 0
    clen := sb.chunks.len()
    while i < clen:
        res = res + sb.chunks[i]
        i = i + 1
    return res
