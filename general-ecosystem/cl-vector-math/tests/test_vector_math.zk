// cl-vector-math: Test Suite
import "../vector_math.zk"

fn test_vm():
    v1: vector[int] := [1, 2, 3]
    v2: vector[int] := [4, 5, 6]
    // 4 + 10 + 18 = 32
    if vec_dot_product(v1, v2) != 32: sys_exit(1)
    print("test_vm passed: N-dimensional dot product verified")

fn main():
    test_vm()
    print("✓ All tests passed for cl-vector-math!")
