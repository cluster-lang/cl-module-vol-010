// cl-stat-equipartition-stage-24: Test Suite
import "../eq_en_24.zk"

fn test_run():
    res := equipartition_energy_24(100.0)
    diff := res - 1656.7788
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-equipartition-stage-24!")
