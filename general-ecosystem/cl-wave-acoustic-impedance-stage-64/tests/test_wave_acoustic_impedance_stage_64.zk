import "../ac_imp_64.zk"

fn test_run():
    res := acoustic_impedance_64(1.2, 343.0)
    diff := res - 26342.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
