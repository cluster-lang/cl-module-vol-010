// cl-stat-lennard-jones-ratio-stage-51: Test Suite
import "../lj_rt_51.zk"

fn test_run():
    res := lj_inv_r6_51(1.0)
    diff := res - 51.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
