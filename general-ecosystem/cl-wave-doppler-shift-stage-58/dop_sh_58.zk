// cl-wave-doppler-shift-stage-58: Doppler Moving Source Frequency Factor Stage 58
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn doppler_factor_58(c_sound: float, v_source: float) -> float:
    den := c_sound - v_source
    if den <= 0.0001: return 0.0
    return (c_sound / den) * 58.0
