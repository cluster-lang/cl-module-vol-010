// cl-wave-helmholtz-ratio-stage-8: Test Suite
import "../hlm_rt_8.zk"

fn test_run():
    res := helmholtz_ratio_8(0.01, 0.1, 0.05)
    diff := res - 16.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-helmholtz-ratio-stage-8!")
