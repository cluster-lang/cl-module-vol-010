// cl-string-levenshtein-transposition: Transposition Adjacent Character Check
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn can_transpose(s1: string, s2: string, i: int, j: int) -> int:
    if i < 2: return 0
    if j < 2: return 0
    if byte_at(s1, i - 1) != byte_at(s2, j - 2): return 0
    if byte_at(s1, i - 2) != byte_at(s2, j - 1): return 0
    return 1
