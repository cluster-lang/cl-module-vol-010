// cl-ts-holt-linear-level-stage-73: Test Suite
import "../ts_hl_73.zk"

fn test_run():
    res := holt_level_73(20.0, 18.0, 1.0, 0.2)
    diff := res - 1401.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-ts-holt-linear-level-stage-73!")
