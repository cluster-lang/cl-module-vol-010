// cl-vec2-aspect-ratio: Test Suite
import "../v2_aspect.zk"

fn test_op():
    res := vec2_aspect_ratio([16.0, 9.0])
    diff := float(res) - 1.7778
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-aspect-ratio!")
