// cl-vec2-aspect-ratio: Aspect Ratio (Width / Height) with Zero Protection
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_aspect_ratio(v: vector[float]) -> float:
    if v[1] == 0.0: return 0.0
    return v[0] / v[1]
