fn max3(a: int, b: int, c: int) -> int:
    m := a
    if b > m: m = b
    if c > m: m = c
    return m

fn needleman_wunsch_score(s1: string, s2: string, match_score: int, mismatch_penalty: int, gap_penalty: int) -> int:
    m := len(s1)
    n := len(s2)
    stride := n + 1
    dp: vector[int] := []
    total := (m + 1) * (n + 1)
    i := 0
    while i < total:
        dp.push(0)
        i = i + 1

    i = 0
    while i <= m:
        dp[i * stride] = i * gap_penalty
        i = i + 1

    j := 0
    while j <= n:
        dp[j] = j * gap_penalty
        j = j + 1

    i = 1
    while i <= m:
        j = 1
        while j <= n:
            score := mismatch_penalty
            if byte_at(s1, i - 1) == byte_at(s2, j - 1): score = match_score
            diag := dp[((i - 1) * stride) + (j - 1)] + score
            up := dp[((i - 1) * stride) + j] + gap_penalty
            left := dp[(i * stride) + (j - 1)] + gap_penalty
            dp[(i * stride) + j] = max3(diag, up, left)
            j = j + 1
        i = i + 1
    return dp[(m * stride) + n]
