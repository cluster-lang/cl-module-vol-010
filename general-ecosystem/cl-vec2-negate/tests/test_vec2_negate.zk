// cl-vec2-negate: Test Suite
import "../vec2_neg.zk"

fn test_v2_neg():
    v: vector[float] := [3.5, -4.5]
    out: vector[float] := [0.0, 0.0]
    vec2_negate(out, v)
    if out[0] != -3.5 or out[1] != 4.5: sys_exit(1)
    print("test_v2_neg passed")

fn main():
    test_v2_neg()
    print("✓ All tests passed for cl-vec2-negate!")
