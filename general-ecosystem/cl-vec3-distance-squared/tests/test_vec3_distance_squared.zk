// cl-vec3-distance-squared: Test Suite
import "../vec3_dist_sq.zk"

fn test_v3_dist_sq():
    a: vector[float] := [1.0, 2.0, 3.0]
    b: vector[float] := [2.0, 4.0, 5.0]
    // 1 + 4 + 4 = 9.0
    res := vec3_distance_squared(a, b)
    diff := res - 9.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v3_dist_sq passed")

fn main():
    test_v3_dist_sq()
    print("✓ All tests passed for cl-vec3-distance-squared!")
