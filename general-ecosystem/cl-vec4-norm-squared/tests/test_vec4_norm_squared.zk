// cl-vec4-norm-squared: Test Suite
import "../vec4_norm_sq.zk"

fn test_v4_norm_sq():
    v: vector[float] := [1.0, 2.0, 3.0, 4.0]
    // 1 + 4 + 9 + 16 = 30.0
    res := vec4_norm_squared(v)
    diff := res - 30.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v4_norm_sq passed")

fn main():
    test_v4_norm_sq()
    print("✓ All tests passed for cl-vec4-norm-squared!")
