// cl-string-levenshtein-transposition-damerau: Adjacent Transposition Check
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn is_adjacent_transposition(a1: int, a2: int, b1: int, b2: int) -> int:
    if a1 == b2:
        if a2 == b1:
            return 1
    return 0
