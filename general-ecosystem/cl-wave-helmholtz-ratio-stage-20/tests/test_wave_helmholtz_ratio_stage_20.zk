// cl-wave-helmholtz-ratio-stage-20: Test Suite
import "../hlm_rt_20.zk"

fn test_run():
    res := helmholtz_ratio_20(0.01, 0.1, 0.05)
    diff := res - 40.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-helmholtz-ratio-stage-20!")
