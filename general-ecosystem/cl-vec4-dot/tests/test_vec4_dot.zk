// cl-vec4-dot: Test Suite
import "../vec4_dot.zk"

fn test_v4_dot():
    a: vector[float] := [1.0, 2.0, 3.0, 4.0]
    b: vector[float] := [2.0, 3.0, 4.0, 5.0]
    // 2 + 6 + 12 + 20 = 40.0
    res := vec4_dot(a, b)
    diff := res - 40.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v4_dot passed")

fn main():
    test_v4_dot()
    print("✓ All tests passed for cl-vec4-dot!")
