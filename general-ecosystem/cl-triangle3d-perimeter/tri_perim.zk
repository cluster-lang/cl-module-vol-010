fn sqrt_approx(val: float) -> float:
    if val <= 0.0:
        return 0.0
    x := val
    i := 0
    while i < 15:
        x = 0.5 * (x + val / x)
        i = i + 1
    return x

fn triangle3d_perimeter(ax: float, ay: float, az: float, bx: float, by: float, bz: float, cx: float, cy: float, cz: float) -> float:
    abx := bx - ax
    aby := by - ay
    abz := bz - az
    len_ab := sqrt_approx(abx * abx + aby * aby + abz * abz)

    bcx := cx - bx
    bcy := cy - by
    bcz := cz - bz
    len_bc := sqrt_approx(bcx * bcx + bcy * bcy + bcz * bcz)

    cax := ax - cx
    cay := ay - cy
    caz := az - cz
    len_ca := sqrt_approx(cax * cax + cay * cay + caz * caz)

    return len_ab + len_bc + len_ca
