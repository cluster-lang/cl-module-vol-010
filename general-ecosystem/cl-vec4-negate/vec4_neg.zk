// cl-vec4-negate: 4D Vector Component-wise Negation
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec4_negate(out: vector[float], v: vector[float]):
    out[0] = 0.0 - v[0]
    out[1] = 0.0 - v[1]
    out[2] = 0.0 - v[2]
    out[3] = 0.0 - v[3]
