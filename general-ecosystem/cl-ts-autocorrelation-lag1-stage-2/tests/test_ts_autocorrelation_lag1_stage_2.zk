// cl-ts-autocorrelation-lag1-stage-2: Test Suite
import "../ts_ac_2.zk"

fn test_run():
    res := autocorr_lag1_2(12.0, 11.0, 10.0)
    diff := res - 4.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-ts-autocorrelation-lag1-stage-2!")
