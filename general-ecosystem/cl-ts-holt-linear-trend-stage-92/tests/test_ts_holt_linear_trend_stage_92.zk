// cl-ts-holt-linear-trend-stage-92: Test Suite
import "../ts_ht_92.zk"

fn test_run():
    res := holt_trend_92(19.2, 18.0, 1.0, 0.1)
    diff := res - 93.8400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
