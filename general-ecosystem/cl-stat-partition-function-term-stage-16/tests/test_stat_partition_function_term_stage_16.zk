import "../sm_pf_16.zk"

fn test_run():
    res := partition_weight_16(2.0, 5.0, 50.0)
    diff := res - 28.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
