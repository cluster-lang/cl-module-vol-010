// cl-string-rabin-karp-multi-count: Test Suite
import "../rk_multi_cnt.zk"

fn test_rk_multi_cnt():
    t: vector[int] := [65, 66, 65, 66, 65]
    p: vector[int] := [65, 66, 65]
    c := rk_single_count(t, p)
    if c != 2: sys_exit(1)
    print("test_rk_multi_cnt passed: 2 matches verified")

fn main():
    test_rk_multi_cnt()
    print("✓ All tests passed for cl-string-rabin-karp-multi-count!")
