// cl-string-rabin-karp-multi-pattern-hash: Test Suite
import "../rk_multi_p.zk"

fn test_rk_multi_p():
    // Two 2-char patterns: "AB" [65, 66] and "CD" [67, 68]
    patterns: vector[int] := [65, 66, 67, 68]
    hashes: vector[int] := []
    rabin_karp_hash_patterns(hashes, patterns, 2, 2)
    if hashes.len() != 2: sys_exit(1)
    exp0 := (65 * 257 + 66) % 1000000007
    exp1 := (67 * 257 + 68) % 1000000007
    if hashes[0] != exp0 or hashes[1] != exp1: sys_exit(1)
    print("test_rk_multi_p passed")

fn main():
    test_rk_multi_p()
    print("✓ All tests passed for cl-string-rabin-karp-multi-pattern-hash!")
