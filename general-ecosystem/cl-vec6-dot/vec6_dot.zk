// cl-vec6-dot: 6D Vector Dot Product Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec6_dot(a: vector[float], b: vector[float]) -> float:
    sum := 0.0
    i := 0
    while i < 6:
        sum = sum + a[i] * b[i]
        i = i + 1
    return sum
