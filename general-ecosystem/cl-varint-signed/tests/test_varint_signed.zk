// cl-varint-signed: Test Suite
import "../varint_signed.zk"

fn test_varint_signed():
    out: vector[int] := []
    zigzag_varint_encode(-1, out)
    if out.len() != 1: sys_exit(1)
    if out[0] != 1: sys_exit(1) // -1 -> zigzag 1 -> 1 byte
    print("test_varint_signed passed: -1 encoded as varint [1]")

fn main():
    test_varint_signed()
    print("✓ All tests passed for cl-varint-signed!")
