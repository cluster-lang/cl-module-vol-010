// cl-stat-boltzmann-prob-stage-56: Test Suite
import "../sm_bp_56.zk"

fn test_run():
    res := boltzmann_ratio_56(10.0, 8.0, 20.0)
    diff := res - 50.4000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-prob-stage-56!")
