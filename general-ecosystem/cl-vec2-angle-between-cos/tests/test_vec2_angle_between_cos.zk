// cl-vec2-angle-between-cos: Test Suite
import "../v2_cos.zk"

fn test_op():
    res := vec2_angle_cos([1.0, 0.0], [0.0, 1.0])
    diff := float(res) - 0.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-angle-between-cos!")
