fn triangulate_convex_fan(n_vertices: int) -> vector[int]:
    // For n convex vertices 0..n-1, fan triangulation from vertex 0
    indices: vector[int] := []
    i := 1
    while i < (n_vertices - 1):
        indices.push(0)
        indices.push(i)
        indices.push(i + 1)
        i = i + 1
    return indices

fn triangle_area_2x(x0: int, y0: int, x1: int, y1: int, x2: int, y2: int) -> int:
    return (x0 * (y1 - y2)) + (x1 * (y2 - y0)) + (x2 * (y0 - y1))
