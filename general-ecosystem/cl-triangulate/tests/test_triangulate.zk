// cl-triangulate: Test Suite
import "../triangulate.zk"

fn test_triangulate():
    indices := triangulate_convex_fan(5) // Pentagon -> 3 triangles (9 indices)
    if indices.len() != 9: sys_exit(1)
    if indices[0] != 0: sys_exit(1)
    if indices[1] != 1: sys_exit(1)
    if indices[2] != 2: sys_exit(1)
    if indices[6] != 0: sys_exit(1)
    if indices[7] != 3: sys_exit(1)
    if indices[8] != 4: sys_exit(1)

    area2 := triangle_area_2x(0, 0, 4, 0, 0, 3)
    if area2 != 12: sys_exit(1)
    print("test_triangulate passed: convex polygon triangulation verified")

fn main():
    test_triangulate()
    print("✓ All tests passed for cl-triangulate!")
