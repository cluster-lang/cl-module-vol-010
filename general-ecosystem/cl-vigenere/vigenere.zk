// cl-vigenere: Pure Cluster Vigenère Polyalphabetic Cipher
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vigenere_encrypt(text: string, key: string) -> string:
    res := ""
    tlen := len(text)
    klen := len(key)
    if klen == 0:
        return text
    i := 0
    ki := 0
    while i < tlen:
        b := byte_at(text, i)
        kb := byte_at(key, ki % klen)
        shift := 0
        if kb >= 65 and kb <= 90:
            shift = kb - 65
        elif kb >= 97 and kb <= 122:
            shift = kb - 97

        if b >= 65 and b <= 90:
            res = res + chr(((b - 65 + shift) % 26) + 65)
            ki = ki + 1
        elif b >= 97 and b <= 122:
            res = res + chr(((b - 97 + shift) % 26) + 97)
            ki = ki + 1
        else:
            res = res + chr(b)
        i = i + 1
    return res

fn vigenere_decrypt(text: string, key: string) -> string:
    res := ""
    tlen := len(text)
    klen := len(key)
    if klen == 0:
        return text
    i := 0
    ki := 0
    while i < tlen:
        b := byte_at(text, i)
        kb := byte_at(key, ki % klen)
        shift := 0
        if kb >= 65 and kb <= 90:
            shift = kb - 65
        elif kb >= 97 and kb <= 122:
            shift = kb - 97

        if b >= 65 and b <= 90:
            res = res + chr(((b - 65 - shift + 26) % 26) + 65)
            ki = ki + 1
        elif b >= 97 and b <= 122:
            res = res + chr(((b - 97 - shift + 26) % 26) + 97)
            ki = ki + 1
        else:
            res = res + chr(b)
        i = i + 1
    return res
