// cl-varint-zigzag-encode16-fast: Test Suite
import "../zz16.zk"

fn test_zz16():
    if zigzag_encode16_fast(0) != 0: sys_exit(1)
    if zigzag_encode16_fast(-1) != 1: sys_exit(2)
    if zigzag_encode16_fast(1) != 2: sys_exit(3)
    if zigzag_encode16_fast(-2) != 3: sys_exit(4)
    print("test_zz16 passed: 16-bit zigzag encoding verified")

fn main():
    test_zz16()
    print("✓ All tests passed for cl-varint-zigzag-encode16-fast!")
