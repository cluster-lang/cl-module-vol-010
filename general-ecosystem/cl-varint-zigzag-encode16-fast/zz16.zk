// cl-varint-zigzag-encode16-fast: Fast 16-bit Zigzag Integer Encoder
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn zigzag_encode16_fast(n: int) -> int:
    mask16 := 65535
    if n >= 0:
        return (n << 1) & mask16
    else:
        pos := 0 - n
        return ((pos << 1) - 1) & mask16
