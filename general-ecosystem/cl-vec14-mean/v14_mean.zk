// cl-vec14-mean: 14D Vector Arithmetic Mean of Components
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec14_mean(a: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 14:
        s = s + a[i]
        i = i + 1
    return s / 14.0
