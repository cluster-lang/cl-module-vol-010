import "../ts_ht_87.zk"

fn test_run():
    res := holt_trend_87(19.2, 18.0, 1.0, 0.1)
    diff := res - 88.7400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
