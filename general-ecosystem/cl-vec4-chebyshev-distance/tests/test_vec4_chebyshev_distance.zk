// cl-vec4-chebyshev-distance: Test Suite
import "../vec4_cheb_dist.zk"

fn test_v4_cheb_dist():
    a: vector[float] := [1.0, 2.0, 3.0, 4.0]
    b: vector[float] := [2.0, 8.0, 5.0, 6.0]
    // dx=1, dy=6, dz=2, dw=2 -> max is 6.0
    res := vec4_chebyshev_distance(a, b)
    diff := res - 6.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v4_cheb_dist passed")

fn main():
    test_v4_cheb_dist()
    print("✓ All tests passed for cl-vec4-chebyshev-distance!")
