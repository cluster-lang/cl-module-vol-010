// cl-triangle3d-orthocenter-dist: 2D Triangle Orthocenter Distance Calculator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn triangle2d_orthocenter_dist(v0: vector[float], v1: vector[float], v2: vector[float], pt: vector[float]) -> float:
    a1 := v2[0] - v1[0]
    b1 := v2[1] - v1[1]
    c1 := a1 * v0[0] + b1 * v0[1]

    a2 := v2[0] - v0[0]
    b2 := v2[1] - v0[1]
    c2 := a2 * v1[0] + b2 * v1[1]

    det := a1 * b2 - a2 * b1
    det_abs := det
    if det_abs < 0.0: det_abs = 0.0 - det_abs
    if det_abs < 0.000001:
        return 0.0

    hx := (c1 * b2 - c2 * b1) / det
    hy := (a1 * c2 - a2 * c1) / det

    dx := hx - pt[0]
    dy := hy - pt[1]
    return dx * dx + dy * dy
