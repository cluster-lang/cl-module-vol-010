// cl-triangle3d-orthocenter-dist: Test Suite
import "../ortho.zk"

fn test_ortho():
    // Right triangle at (0,0), (4,0), (0,3). Orthocenter is (0,0).
    v0: vector[float] := [0.0, 0.0]
    v1: vector[float] := [4.0, 0.0]
    v2: vector[float] := [0.0, 3.0]
    pt: vector[float] := [3.0, 4.0]
    // dist squared from (0,0) to (3,4) is 9 + 16 = 25.0
    dist_sq := triangle2d_orthocenter_dist(v0, v1, v2, pt)
    diff := dist_sq - 25.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_ortho passed")

fn main():
    test_ortho()
    print("✓ All tests passed for cl-triangle3d-orthocenter-dist!")
