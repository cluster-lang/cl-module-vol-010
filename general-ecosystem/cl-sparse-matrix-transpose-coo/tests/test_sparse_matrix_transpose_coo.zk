// cl-sparse-matrix-transpose-coo: Test Suite
import "../sp_trans.zk"

fn test_sp_trans():
    rows: vector[int] := [0, 1]
    cols: vector[int] := [2, 3]
    res := sparse_coo_transpose(rows, cols)
    // new_rows should be [2, 3]
    if res[0] != 2: sys_exit(1)
    if res[1] != 3: sys_exit(2)
    // new_cols should be [0, 1]
    if res[2] != 0: sys_exit(3)
    if res[3] != 1: sys_exit(4)
    print("test_sp_trans passed: COO transpose verified")

fn main():
    test_sp_trans()
    print("✓ All tests passed for cl-sparse-matrix-transpose-coo!")
