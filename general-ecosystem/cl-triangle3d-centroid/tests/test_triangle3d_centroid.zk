// cl-triangle3d-centroid: Test Suite
import "../tri_cent.zk"

fn test_tri_cent():
    out: vector[float] := []
    triangle3d_centroid(out, 0.0, 0.0, 0.0, 3.0, 0.0, 0.0, 0.0, 3.0, 0.0)
    if out[0] != 1.0: sys_exit(1)
    if out[1] != 1.0: sys_exit(1)
    if out[2] != 0.0: sys_exit(1)
    print("test_tri_cent passed: 3D triangle centroid verified")

fn main():
    test_tri_cent()
    print("✓ All tests passed for cl-triangle3d-centroid!")
