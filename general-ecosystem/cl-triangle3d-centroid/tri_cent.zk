fn triangle3d_centroid(out: vector[float], ax: float, ay: float, az: float, bx: float, by: float, bz: float, cx: float, cy: float, cz: float):
    inv3 := 1.0 / 3.0
    out.push((ax + bx + cx) * inv3)
    out.push((ay + by + cy) * inv3)
    out.push((az + bz + cz) * inv3)
