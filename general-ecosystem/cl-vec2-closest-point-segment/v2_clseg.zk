// cl-vec2-closest-point-segment: Closest Point on 2D Line Segment Clamped to Ends
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_closest_point_segment(p: vector[float], a: vector[float], b: vector[float]) -> vector[float]:
    abx := b[0] - a[0]
    aby := b[1] - a[1]
    ab_sq := abx*abx + aby*aby
    if ab_sq <= 0.000001: return a
    apx := p[0] - a[0]
    apy := p[1] - a[1]
    t := (apx*abx + apy*aby) / ab_sq
    if t < 0.0: t = 0.0
    if t > 1.0: t = 1.0
    return [a[0] + t * abx, a[1] + t * aby]
