// cl-sparse-matrix-col-sum-coo: COO Sparse Matrix Column Sum Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sparse_coo_col_sum(cols: vector[int], vals: vector[int], target_col: int) -> int:
    sum := 0
    i := 0
    nnz := cols.len()
    while i < nnz:
        if cols[i] == target_col:
            sum = sum + vals[i]
        i = i + 1
    return sum
