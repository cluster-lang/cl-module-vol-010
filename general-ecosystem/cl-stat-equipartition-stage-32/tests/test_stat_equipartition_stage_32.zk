// cl-stat-equipartition-stage-32: Test Suite
import "../eq_en_32.zk"

fn test_run():
    res := equipartition_energy_32(100.0)
    diff := res - 2209.0384
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-equipartition-stage-32!")
