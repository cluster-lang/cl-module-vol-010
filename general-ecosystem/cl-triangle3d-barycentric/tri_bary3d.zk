// cl-triangle3d-barycentric: 3D Triangle Barycentric Weights Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn triangle2d_barycentric(out: vector[float], px: float, py: float, x1: float, y1: float, x2: float, y2: float, x3: float, y3: float):
    denom := (y2 - y3) * (x1 - x3) + (x3 - x2) * (y1 - y3)
    if denom == 0.0:
        out.push(0.33333)
        out.push(0.33333)
        out.push(0.33333)
        return
    w1 := ((y2 - y3) * (px - x3) + (x3 - x2) * (py - y3)) / denom
    w2 := ((y3 - y1) * (px - x3) + (x1 - x3) * (py - y3)) / denom
    w3 := 1.0 - w1 - w2
    out.push(w1)
    out.push(w2)
    out.push(w3)
