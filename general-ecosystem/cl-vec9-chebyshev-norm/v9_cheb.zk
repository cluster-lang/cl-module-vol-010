// cl-vec9-chebyshev-norm: 9D Vector Chebyshev L-infinity Norm
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec9_chebyshev(a: vector[float]) -> float:
    max := 0.0
    i := 0
    while i < 9:
        v := a[i]
        if v < 0.0: v = 0.0 - v
        if v > max: max = v
        i = i + 1
    return max
