// cl-vec10-max-element: 10D Vector Maximum Element
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec10_max(a: vector[float]) -> float:
    max := a[0]
    i := 1
    while i < 10:
        if a[i] > max: max = a[i]
        i = i + 1
    return max
