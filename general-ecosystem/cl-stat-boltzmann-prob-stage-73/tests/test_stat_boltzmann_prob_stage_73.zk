// cl-stat-boltzmann-prob-stage-73: Test Suite
import "../sm_bp_73.zk"

fn test_run():
    res := boltzmann_ratio_73(10.0, 8.0, 20.0)
    diff := res - 65.7000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-prob-stage-73!")
