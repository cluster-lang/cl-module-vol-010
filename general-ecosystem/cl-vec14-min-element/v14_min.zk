// cl-vec14-min-element: 14D Vector Minimum Component
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec14_min(a: vector[float]) -> float:
    min := a[0]
    i := 1
    while i < 14:
        if a[i] < min: min = a[i]
        i = i + 1
    return min
