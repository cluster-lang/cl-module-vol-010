// cl-wave-wavenumber-k-stage-12: Test Suite
import "../wav_k_12.zk"

fn test_run():
    res := wave_number_k_12(628.3, 314.15)
    diff := res - 24.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-wavenumber-k-stage-12!")
