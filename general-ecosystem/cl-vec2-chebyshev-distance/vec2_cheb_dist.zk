// cl-vec2-chebyshev-distance: 2D Chebyshev L-infinity Distance
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_chebyshev_distance(a: vector[float], b: vector[float]) -> float:
    dx := a[0] - b[0]
    if dx < 0.0: dx = 0.0 - dx
    dy := a[1] - b[1]
    if dy < 0.0: dy = 0.0 - dy
    if dy > dx:
        return dy
    return dx
