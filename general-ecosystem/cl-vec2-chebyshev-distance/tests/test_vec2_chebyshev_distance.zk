// cl-vec2-chebyshev-distance: Test Suite
import "../vec2_cheb_dist.zk"

fn test_v2_cheb_dist():
    a: vector[float] := [1.0, 2.0]
    b: vector[float] := [8.0, 5.0]
    // dx=7, dy=3 -> max is 7.0
    res := vec2_chebyshev_distance(a, b)
    diff := res - 7.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_cheb_dist passed")

fn main():
    test_v2_cheb_dist()
    print("✓ All tests passed for cl-vec2-chebyshev-distance!")
