// cl-string-jaro-winkler-score: Test Suite
import "../jw_score.zk"

fn test_jw_score():
    // jaro=0.8, prefix=3, factor=0.1 -> 0.8 + 3*0.1*(1 - 0.8) = 0.8 + 0.06 = 0.86
    jw := jaro_winkler_calc(0.8, 3, 0.1)
    diff := jw - 0.86
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_jw_score passed: Jaro-Winkler score 0.86 verified")

fn main():
    test_jw_score()
    print("✓ All tests passed for cl-string-jaro-winkler-score!")
