// cl-string-jaro-winkler-score: Full Jaro-Winkler Distance Calculation
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn jaro_winkler_calc(jaro_dist: float, prefix_len: int, scaling_factor: float) -> float:
    return jaro_dist + (prefix_len * 1.0) * scaling_factor * (1.0 - jaro_dist)
