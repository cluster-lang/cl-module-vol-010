// cl-stats-standardize-zscore: Standard Z-Score Scaler
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn stats_zscore(x: float, mean: float, std_dev: float) -> float:
    if std_dev < 0.000001 and std_dev > (0.0 - 0.000001): return 0.0
    return (x - mean) / std_dev
