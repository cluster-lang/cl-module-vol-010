// cl-stats-standardize-zscore: Test Suite
import "../st_zsc.zk"

fn test_st_zsc():
    res := stats_zscore(12.0, 10.0, 2.0)
    diff := res - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_st_zsc passed")

fn main():
    test_st_zsc()
    print("✓ All tests passed for cl-stats-standardize-zscore!")
