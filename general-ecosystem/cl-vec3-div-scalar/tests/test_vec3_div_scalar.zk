// cl-vec3-div-scalar: Test Suite
import "../v3_divs.zk"

fn test_op():
    res := vec3_div_scalar([10.0, 20.0, 30.0], 2.0)
    diff0 := res[0] - 5.0000
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    diff1 := res[1] - 10.0000
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    diff2 := res[2] - 15.0000
    if diff2 < 0.0: diff2 = 0.0 - diff2
    if diff2 > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec3-div-scalar!")
