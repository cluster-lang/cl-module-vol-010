// cl-vec2-is-collinear-three: Test Suite
import "../v2_collin.zk"

fn test_op():
    res := vec2_are_collinear([0.0, 0.0], [2.0, 2.0], [5.0, 5.0], 0.001)
    diff := float(res) - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-is-collinear-three!")
