// cl-vec2-is-collinear-three: Check If Three 2D Points Are Collinear
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_are_collinear(p1: vector[float], p2: vector[float], p3: vector[float], eps: float) -> int:
    area2 := p1[0]*(p2[1] - p3[1]) + p2[0]*(p3[1] - p1[1]) + p3[0]*(p1[1] - p2[1])
    if area2 < 0.0: area2 = 0.0 - area2
    if area2 <= eps: return 1
    return 0
