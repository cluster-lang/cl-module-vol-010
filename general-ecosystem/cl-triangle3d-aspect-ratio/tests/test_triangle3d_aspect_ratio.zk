// cl-triangle3d-aspect-ratio: Test Suite
import "../tri_ar.zk"

fn test_tri_ar():
    // For equilateral triangle, all edges equal -> ar = (a*3) / (3*a) = 1.0
    p := triangle_perimeter(5.0, 5.0, 5.0)
    ar := triangle_aspect_ratio_metric(5.0, p)
    diff := ar - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_tri_ar passed: equilateral aspect ratio 1.0 verified")

fn main():
    test_tri_ar()
    print("✓ All tests passed for cl-triangle3d-aspect-ratio!")
