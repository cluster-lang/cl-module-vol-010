fn triangle_perimeter(a: float, b: float, c: float) -> float:
    return a + b + c

fn triangle_aspect_ratio_metric(longest_edge: float, perimeter: float) -> float:
    if perimeter <= 0.000001: return 0.0
    return (longest_edge * 3.0) / perimeter
