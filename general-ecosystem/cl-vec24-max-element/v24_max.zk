// cl-vec24-max-element: 24D Vector Maximum Component
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec24_max(a: vector[float]) -> float:
    max := a[0]
    i := 1
    while i < 24:
        if a[i] > max: max = a[i]
        i = i + 1
    return max
