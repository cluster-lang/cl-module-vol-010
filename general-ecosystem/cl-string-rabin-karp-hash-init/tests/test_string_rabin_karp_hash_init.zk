// cl-string-rabin-karp-hash-init: Test Suite
import "../rk_init.zk"

fn test_rk_init():
    text: vector[int] := [65, 66, 67]
    h := rk_initial_hash_k(text, 2, 256, 1000000007)
    // 65 * 256 + 66 = 16706
    if h != 16706: sys_exit(1)
    print("test_rk_init passed: initial k-length rolling hash verified")

fn main():
    test_rk_init()
    print("✓ All tests passed for cl-string-rabin-karp-hash-init!")
