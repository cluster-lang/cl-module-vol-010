// cl-ts-ar1-predict-stage-79: Test Suite
import "../ts_ar_79.zk"

fn test_run():
    res := ar1_predict_79(2.0, 0.8, 10.0)
    diff := res - 790.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-ts-ar1-predict-stage-79!")
