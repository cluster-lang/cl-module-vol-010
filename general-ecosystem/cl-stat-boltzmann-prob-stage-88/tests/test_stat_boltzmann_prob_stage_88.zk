// cl-stat-boltzmann-prob-stage-88: Test Suite
import "../sm_bp_88.zk"

fn test_run():
    res := boltzmann_ratio_88(10.0, 8.0, 20.0)
    diff := res - 79.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-prob-stage-88!")
