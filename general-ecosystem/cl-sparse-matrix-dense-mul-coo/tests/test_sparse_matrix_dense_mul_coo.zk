// cl-sparse-matrix-dense-mul-coo: Test Suite
import "../coo_mul.zk"

fn test_coo_mul():
    rows: vector[int] := [0, 1]
    cols: vector[int] := [1, 0]
    vals: vector[float] := [3.0, 5.0]
    x: vector[float] := [2.0, 4.0]
    y: vector[float] := [0.0, 0.0]
    sparse_coo_matvec_mul(y, rows, cols, vals, x)
    // y[0] = vals[0] * x[1] = 3.0 * 4.0 = 12.0
    // y[1] = vals[1] * x[0] = 5.0 * 2.0 = 10.0
    diff0 := y[0] - 12.0
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.0001: sys_exit(1)
    diff1 := y[1] - 10.0
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.0001: sys_exit(1)
    print("test_coo_mul passed")

fn main():
    test_coo_mul()
    print("✓ All tests passed for cl-sparse-matrix-dense-mul-coo!")
