// cl-sparse-matrix-dense-mul-coo: COO Sparse Matrix Vector Multiply
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn spmv_coo(out_y: vector[int], rows: vector[int], cols: vector[int], vals: vector[int], x: vector[int]):
    i := 0
    nnz := rows.len()
    while i < nnz:
        r := rows[i]
        c := cols[i]
        v := vals[i]
        out_y[r] = out_y[r] + v * x[c]
        i = i + 1
