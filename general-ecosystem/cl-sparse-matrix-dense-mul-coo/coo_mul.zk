// cl-sparse-matrix-dense-mul-coo: Sparse COO Matrix-Vector Multiplication
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sparse_coo_matvec_mul(y: vector[float], rows: vector[int], cols: vector[int], vals: vector[float], x: vector[float]):
    ylen := y.len()
    i := 0
    while i < ylen:
        y[i] = 0.0
        i = i + 1
    nnz := vals.len()
    k := 0
    while k < nnz:
        r := rows[k]
        c := cols[k]
        v := vals[k]
        y[r] = y[r] + v * x[c]
        k = k + 1
