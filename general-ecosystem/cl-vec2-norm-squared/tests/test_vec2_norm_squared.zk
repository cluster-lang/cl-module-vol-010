// cl-vec2-norm-squared: Test Suite
import "../vec2_norm_sq.zk"

fn test_v2_norm_sq():
    v: vector[float] := [3.0, 4.0]
    res := vec2_norm_squared(v)
    diff := res - 25.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_norm_sq passed")

fn main():
    test_v2_norm_sq()
    print("✓ All tests passed for cl-vec2-norm-squared!")
