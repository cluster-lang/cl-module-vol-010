// cl-vec3-lerp: Test Suite
import "../vec3_lerp.zk"

fn test_v3_lerp():
    a: vector[float] := [0.0, 10.0, 20.0]
    b: vector[float] := [10.0, 20.0, 30.0]
    out: vector[float] := [0.0, 0.0, 0.0]
    vec3_lerp(out, a, b, 0.5)
    if out[0] != 5.0 or out[1] != 15.0 or out[2] != 25.0: sys_exit(1)
    print("test_v3_lerp passed")

fn main():
    test_v3_lerp()
    print("✓ All tests passed for cl-vec3-lerp!")
