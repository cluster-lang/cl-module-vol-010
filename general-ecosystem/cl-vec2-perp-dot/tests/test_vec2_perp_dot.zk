// cl-vec2-perp-dot: Test Suite
import "../vec2_pdot.zk"

fn test_v2_pdot():
    a: vector[float] := [1.0, 0.0]
    b: vector[float] := [0.0, 1.0]
    // 1*1 - 0*0 = 1.0
    res := vec2_perp_dot(a, b)
    diff := res - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_pdot passed")

fn main():
    test_v2_pdot()
    print("✓ All tests passed for cl-vec2-perp-dot!")
