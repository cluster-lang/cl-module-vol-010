// cl-vec5-add: 5D Vector Component-wise Addition
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec5_add(out: vector[float], a: vector[float], b: vector[float]):
    i := 0
    while i < 5:
        out[i] = a[i] + b[i]
        i = i + 1
