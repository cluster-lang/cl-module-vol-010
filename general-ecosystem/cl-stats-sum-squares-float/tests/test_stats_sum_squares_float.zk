// cl-stats-sum-squares-float: Test Suite
import "../st_ssq.zk"

fn test_st_ssq():
    v: vector[float] := [1.0, 2.0, 3.0]
    res := stats_sum_squares(v)
    diff := res - 14.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_st_ssq passed")

fn main():
    test_st_ssq()
    print("✓ All tests passed for cl-stats-sum-squares-float!")
