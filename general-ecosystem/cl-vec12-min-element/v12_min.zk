// cl-vec12-min-element: 12D Vector Minimum Component
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec12_min(a: vector[float]) -> float:
    min := a[0]
    i := 1
    while i < 12:
        if a[i] < min: min = a[i]
        i = i + 1
    return min
