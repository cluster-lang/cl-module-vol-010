// cl-thermo-ideal-gas-stage-1: Test Suite
import "../gas_pr_1.zk"

fn test_run():
    res := ideal_gas_pressure_1(1.0, 300.0, 1.0)
    diff := res - 2494.3386
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-thermo-ideal-gas-stage-1!")
