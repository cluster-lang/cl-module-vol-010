// cl-stat-sample-weight-scale-35: Test Suite
import "../stat_w_35.zk"

fn test_run():
    res := sample_stat_weight_35(10.0)
    diff := res - 350.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-sample-weight-scale-35!")
