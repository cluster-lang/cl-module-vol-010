// cl-sphere-ray-cast: Test Suite
import "../sphere_cast.zk"

fn test_sphere_cast():
    ro: vector[float] := [0.0, 0.0, 10.0]
    rd: vector[float] := [0.0, 0.0, -1.0]
    sc: vector[float] := [0.0, 0.0, 0.0]
    t := ray_sphere_cast(ro, rd, sc, 2.0)
    // Distance from z=10 to sphere surface at z=2 is 8.0
    diff := t - 8.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_sphere_cast passed: ray sphere intersection 8.0 verified")

fn main():
    test_sphere_cast()
    print("✓ All tests passed for cl-sphere-ray-cast!")
