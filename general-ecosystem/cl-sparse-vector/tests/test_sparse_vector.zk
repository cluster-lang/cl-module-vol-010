// cl-sparse-vector: Test Suite
import "../sparse_vec.zk"

fn test_sparse_vec():
    v1: vector[int] := [0, 5, 2, 10, 5, 2]
    v2: vector[int] := [1, 7, 2, 3, 5, 4]
    // Common indices: 2 (10*3 = 30) and 5 (2*4 = 8) -> sum = 38
    dot := sparse_vec_dot(v1, v2)
    if dot != 38: sys_exit(1)
    print("test_sparse_vec passed: sparse dot product verified")

fn main():
    test_sparse_vec()
    print("✓ All tests passed for cl-sparse-vector!")
