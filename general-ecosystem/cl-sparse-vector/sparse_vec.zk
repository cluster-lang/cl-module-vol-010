// Sparse vectors: flat pairs [index0, val0, index1, val1, ...] sorted by index
fn sparse_vec_dot(v1: vector[int], v2: vector[int]) -> int:
    n1 := v1.len() / 2
    n2 := v2.len() / 2
    i1 := 0
    i2 := 0
    total := 0
    while i1 < n1:
        if i2 >= n2: return total
        idx1 := v1[i1 * 2]
        idx2 := v2[i2 * 2]
        if idx1 == idx2:
            total = total + (v1[(i1 * 2) + 1] * v2[(i2 * 2) + 1])
            i1 = i1 + 1
            i2 = i2 + 1
        else:
            if idx1 < idx2:
                i1 = i1 + 1
            else:
                i2 = i2 + 1
    return total
