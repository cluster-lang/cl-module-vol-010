// cl-vec3-clamp: Test Suite
import "../vec3_clamp.zk"

fn test_v3_clamp():
    v: vector[float] := [-2.0, 5.0, 15.0]
    out: vector[float] := [0.0, 0.0, 0.0]
    vec3_clamp(out, v, 0.0, 10.0)
    if out[0] != 0.0 or out[1] != 5.0 or out[2] != 10.0: sys_exit(1)
    print("test_v3_clamp passed")

fn main():
    test_v3_clamp()
    print("✓ All tests passed for cl-vec3-clamp!")
