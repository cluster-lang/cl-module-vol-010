// cl-vec8-dot: 8D Vector Dot Product Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec8_dot(a: vector[float], b: vector[float]) -> float:
    sum := 0.0
    i := 0
    while i < 8:
        sum = sum + a[i] * b[i]
        i = i + 1
    return sum
