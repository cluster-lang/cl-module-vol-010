// cl-sparse-matrix-dense-add-coo: Test Suite
import "../sp_add_dense.zk"

fn test_sp_add_dense():
    dense: vector[float] := [1.0, 1.0, 1.0, 1.0]
    rows: vector[int] := [0, 1]
    cols: vector[int] := [0, 1]
    vals: vector[float] := [2.0, 3.0]
    res := sparse_coo_add_to_dense(dense, rows, cols, vals, 2)
    if res[0] != 3.0: sys_exit(1)
    if res[1] != 1.0: sys_exit(2)
    if res[2] != 1.0: sys_exit(3)
    if res[3] != 4.0: sys_exit(4)
    print("test_sp_add_dense passed: COO accumulation into dense buffer verified")

fn main():
    test_sp_add_dense()
    print("✓ All tests passed for cl-sparse-matrix-dense-add-coo!")
