// cl-stat-partition-function-term-stage-20: Canonical Partition Function Weight Stage 20
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn partition_weight_20(g: float, e: float, kt: float) -> float:
    return g * (1.0 - e / kt) * 20.0
