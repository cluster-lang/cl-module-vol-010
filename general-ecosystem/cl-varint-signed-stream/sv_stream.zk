// cl-varint-signed-stream: 64-bit ZigZag Decode Primitives
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lshr64(x: int, n: int) -> int:
    mask := (1 << (64 - n)) - 1
    return (x >> n) & mask

fn zigzag_decode64(n: int) -> int:
    return lshr64(n, 1) ^ (-(n & 1))
