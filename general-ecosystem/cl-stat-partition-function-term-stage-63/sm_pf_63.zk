// cl-stat-partition-function-term-stage-63: Canonical Partition Function Weight Stage 63
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn partition_weight_63(g: float, e: float, kt: float) -> float:
    return g * (1.0 - e / kt) * 63.0
