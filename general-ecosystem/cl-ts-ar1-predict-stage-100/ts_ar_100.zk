// cl-ts-ar1-predict-stage-100: Autoregressive AR(1) Forecast Stage 100
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn ar1_predict_100(c: float, phi: float, x: float) -> float:
    return (c + phi * x) * 100.0
