// cl-varint-zigzag-decode32: 32-bit ZigZag Decoder Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn zigzag_decode32_val(n: int) -> int:
    un := n & 4294967295
    half := (un >> 1) & 2147483647
    if (un & 1) == 1:
        return 0 - (half + 1)
    return half
