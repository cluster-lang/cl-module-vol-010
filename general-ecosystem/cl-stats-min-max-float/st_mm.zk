// cl-stats-min-max-float: Vector Min-Max Bounds Extractor
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn stats_min_max(out_mm: vector[float], v: vector[float]):
    n := v.len()
    if n == 0:
        out_mm[0] = 0.0; out_mm[1] = 0.0
        return
    min_v := v[0]
    max_v := v[0]
    i := 1
    while i < n:
        if v[i] < min_v: min_v = v[i]
        if v[i] > max_v: max_v = v[i]
        i = i + 1
    out_mm[0] = min_v
    out_mm[1] = max_v
