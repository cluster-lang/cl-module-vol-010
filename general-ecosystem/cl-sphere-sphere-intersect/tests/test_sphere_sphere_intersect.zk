// cl-sphere-sphere-intersect: Test Suite
import "../sph_sph.zk"

fn test_sph_sph():
    if spheres_overlap(0.0, 0.0, 0.0, 2.0, 3.0, 0.0, 0.0, 2.0) != 1: sys_exit(1)
    if spheres_overlap(0.0, 0.0, 0.0, 2.0, 5.0, 0.0, 0.0, 2.0) != 0: sys_exit(1)
    print("test_sph_sph passed: sphere overlap collision verified")

fn main():
    test_sph_sph()
    print("✓ All tests passed for cl-sphere-sphere-intersect!")
