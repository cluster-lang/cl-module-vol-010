// cl-stat-gibbs-free-energy-stage-15: Test Suite
import "../sm_ge_15.zk"

fn test_run():
    res := gibbs_energy_15(1200.0, 300.0, 3.0)
    diff := res - 4500.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-gibbs-free-energy-stage-15!")
