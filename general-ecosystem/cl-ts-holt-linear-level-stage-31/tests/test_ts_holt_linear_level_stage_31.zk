// cl-ts-holt-linear-level-stage-31: Test Suite
import "../ts_hl_31.zk"

fn test_run():
    res := holt_level_31(20.0, 18.0, 1.0, 0.2)
    diff := res - 595.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-ts-holt-linear-level-stage-31!")
