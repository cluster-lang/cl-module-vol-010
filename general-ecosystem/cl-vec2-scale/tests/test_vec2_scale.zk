// cl-vec2-scale: Test Suite
import "../vec2_scale.zk"

fn test_v2_scale():
    v: vector[float] := [2.5, -4.0]
    out: vector[float] := [0.0, 0.0]
    vec2_scale(out, v, 2.0)
    diff0 := out[0] - 5.0
    if diff0 < 0.0: diff0 = 0.0 - diff0
    diff1 := out[1] - (0.0 - 8.0)
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff0 > 0.0001 or diff1 > 0.0001: sys_exit(1)
    print("test_v2_scale passed")

fn main():
    test_v2_scale()
    print("✓ All tests passed for cl-vec2-scale!")
