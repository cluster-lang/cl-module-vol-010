// cl-vec5-sum: Test Suite
import "../vec5_sum.zk"

fn test_v5_sum():
    v: vector[float] := [2.0, 2.0, 2.0, 2.0, 2.0]
    res := vec5_sum(v)
    diff := res - 10.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v5_sum passed")

fn main():
    test_v5_sum()
    print("✓ All tests passed for cl-vec5-sum!")
