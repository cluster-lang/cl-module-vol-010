// cl-vec2-rotate-90-cw: Test Suite
import "../v2_r90cw.zk"

fn test_op():
    res := vec2_rotate_90_cw([1.0, 2.0])
    diff0 := res[0] - 2.0000
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    diff1 := res[1] - -1.0000
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-rotate-90-cw!")
