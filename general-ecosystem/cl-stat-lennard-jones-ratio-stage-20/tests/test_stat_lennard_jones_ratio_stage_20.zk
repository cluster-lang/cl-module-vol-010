// cl-stat-lennard-jones-ratio-stage-20: Test Suite
import "../lj_rt_20.zk"

fn test_run():
    res := lj_inv_r6_20(1.0)
    diff := res - 20.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-lennard-jones-ratio-stage-20!")
