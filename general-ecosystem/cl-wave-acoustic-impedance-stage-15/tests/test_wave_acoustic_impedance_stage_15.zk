import "../ac_imp_15.zk"

fn test_run():
    res := acoustic_impedance_15(1.2, 343.0)
    diff := res - 6174.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
