// cl-vec2-reject: Test Suite
import "../v2_rej.zk"

fn test_op():
    res := vec2_reject([3.0, 4.0], [1.0, 0.0])
    diff0 := res[0] - 0.0000
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    diff1 := res[1] - 4.0000
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-reject!")
