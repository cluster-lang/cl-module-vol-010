// cl-stat-partition-function-term-stage-75: Test Suite
import "../sm_pf_75.zk"

fn test_run():
    res := partition_weight_75(2.0, 5.0, 50.0)
    diff := res - 135.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-partition-function-term-stage-75!")
