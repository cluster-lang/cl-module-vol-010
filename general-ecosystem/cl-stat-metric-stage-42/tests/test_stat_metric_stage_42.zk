// cl-stat-metric-stage-42: Test Suite
import "../sm_st_42.zk"

fn test_run():
    res := stat_metric_stage_42(1.0)
    diff := res - 42.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-metric-stage-42!")
