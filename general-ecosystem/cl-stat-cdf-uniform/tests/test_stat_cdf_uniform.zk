// cl-stat-cdf-uniform: Test Suite
import "../cdf_unif.zk"

fn test_run():
    res := cdf_uniform(5.0, 0.0, 10.0)
    diff := res - 0.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-cdf-uniform!")
