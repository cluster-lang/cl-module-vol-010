// cl-vec5-norm-squared: Test Suite
import "../vec5_nsq.zk"

fn test_v5_nsq():
    v: vector[float] := [2.0, 2.0, 2.0, 2.0, 2.0]
    res := vec5_norm_squared(v)
    diff := res - 20.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v5_nsq passed")

fn main():
    test_v5_nsq()
    print("✓ All tests passed for cl-vec5-norm-squared!")
