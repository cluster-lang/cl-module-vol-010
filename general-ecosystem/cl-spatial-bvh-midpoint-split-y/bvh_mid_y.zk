// cl-spatial-bvh-midpoint-split-y: Compute BVH Bounding Box Midpoint Split on Y
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bvh_split_mid_y(min_y: float, max_y: float) -> float:
    return 0.5 * (min_y + max_y)
