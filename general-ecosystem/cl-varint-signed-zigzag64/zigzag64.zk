// cl-varint-signed-zigzag64: 64-bit ZigZag Integer Encoding and Decoding
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lshr64(val: int, shift: int) -> int:
    if shift == 0: return val
    mask := (1 << (64 - shift)) - 1
    return (val >> shift) & mask

fn zigzag64_encode(n: int) -> int:
    return (n << 1) ^ (n >> 63)

fn zigzag64_decode(n: int) -> int:
    half := lshr64(n, 1)
    if (n & 1) == 1:
        return 0 - (half + 1)
    return half
