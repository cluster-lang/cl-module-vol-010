fn sqrt_approx(val: float) -> float:
    if val <= 0.0: return 0.0
    x := val
    i := 0
    while i < 15:
        x = 0.5 * (x + val / x)
        i = i + 1
    return x

fn sphere_cone_cull(sx: float, sy: float, sz: float, radius: float, height: float, tan_alpha: float) -> int:
    if sz < (0.0 - radius) or sz > (height + radius):
        return 0
    eff_z := sz
    if eff_z < 0.0: eff_z = 0.0
    cone_r := eff_z * tan_alpha
    center_dist := sqrt_approx(sx * sx + sy * sy)
    if (center_dist - radius) <= cone_r:
        return 1
    return 0
