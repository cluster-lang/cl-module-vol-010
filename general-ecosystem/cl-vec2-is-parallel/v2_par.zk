// cl-vec2-is-parallel: Check If Two 2D Vectors Are Parallel via Cross Product
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_is_parallel(u: vector[float], v: vector[float], eps: float) -> int:
    cross := u[0]*v[1] - u[1]*v[0]
    if cross < 0.0: cross = 0.0 - cross
    if cross <= eps: return 1
    return 0
