// cl-stats-mean-float: Sample Arithmetic Mean
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn stats_mean(v: vector[float]) -> float:
    n := v.len()
    if n == 0: return 0.0
    sum := 0.0
    i := 0
    while i < n:
        sum = sum + v[i]
        i = i + 1
    return sum / float(n)
