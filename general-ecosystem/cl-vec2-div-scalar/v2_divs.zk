// cl-vec2-div-scalar: Divide 2D Vector by Scalar with Zero Guard
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_div_scalar(v: vector[float], s: float) -> vector[float]:
    if s == 0.0: return [0.0, 0.0]
    return [v[0] / s, v[1] / s]
