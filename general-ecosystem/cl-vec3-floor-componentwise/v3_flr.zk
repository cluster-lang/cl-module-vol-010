// cl-vec3-floor-componentwise: Componentwise Floor Function for 3D Vector
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_floor(v: vector[float]) -> vector[float]:
    return [float(int(v[0])), float(int(v[1])), float(int(v[2]))]
