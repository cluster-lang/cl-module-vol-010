// cl-stat-mean-free-path-stage-14: Test Suite
import "../mfp_cp_14.zk"

fn test_run():
    res := mean_free_path_comp_14(1.0, 1.0)
    diff := res - 3.1511
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-mean-free-path-stage-14!")
