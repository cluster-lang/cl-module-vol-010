// cl-vector-29d-dot-stage-4: 29D Vector Dot Product Stage 4
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec29_dot_4(a: vector[float], b: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 29:
        s = s + a[i] * b[i]
        i = i + 1
    return s * 4.0
