// cl-sparse-matrix-row-norm-coo: COO Sparse Matrix Row L1 Norm Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sparse_coo_row_l1(rows: vector[int], vals: vector[int], target_row: int) -> int:
    sum := 0
    i := 0
    nnz := rows.len()
    while i < nnz:
        if rows[i] == target_row:
            v := vals[i]
            if v < 0: v = 0 - v
            sum = sum + v
        i = i + 1
    return sum
