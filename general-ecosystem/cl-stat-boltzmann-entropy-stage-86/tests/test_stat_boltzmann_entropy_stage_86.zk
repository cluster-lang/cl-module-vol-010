// cl-stat-boltzmann-entropy-stage-86: Test Suite
import "../boltz_s_86.zk"

fn test_run():
    res := boltzmann_entropy_factor_86(10.0)
    diff := res - 1187.3581
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-entropy-stage-86!")
