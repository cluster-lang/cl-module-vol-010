fn csc_matvec(vals: vector[int], row_idx: vector[int], col_ptr: vector[int], x: vector[int], y: vector[int]):
    num_cols := col_ptr.len() - 1
    c := 0
    while c < num_cols:
        start_idx := col_ptr[c]
        end_idx := col_ptr[c + 1]
        xc := x[c]
        p := start_idx
        while p < end_idx:
            r := row_idx[p]
            y[r] = y[r] + (vals[p] * xc)
            p = p + 1
        c = c + 1
