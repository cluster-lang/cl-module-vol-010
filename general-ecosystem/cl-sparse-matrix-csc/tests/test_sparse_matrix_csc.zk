// cl-sparse-matrix-csc: Test Suite
import "../csc.zk"

fn test_csc():
    // 2x2 identity matrix: col_ptr=[0, 1, 2], row_idx=[0, 1], vals=[1, 1]
    vals: vector[int] := [1, 1]
    row_idx: vector[int] := [0, 1]
    col_ptr: vector[int] := [0, 1, 2]
    x: vector[int] := [10, 20]
    y: vector[int] := [0, 0]
    csc_matvec(vals, row_idx, col_ptr, x, y)
    if y[0] != 10: sys_exit(1)
    if y[1] != 20: sys_exit(1)
    print("test_csc passed: CSC sparse matrix-vector product verified")

fn main():
    test_csc()
    print("✓ All tests passed for cl-sparse-matrix-csc!")
