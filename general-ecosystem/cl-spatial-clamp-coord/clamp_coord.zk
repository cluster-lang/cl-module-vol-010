// cl-spatial-clamp-coord: Clamp Coordinate to Grid Index [0, size - 1]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn clamp_coordinate(c: int, size: int) -> int:
    if c < 0: return 0
    if c >= size: return size - 1
    return c
