// cl-sphere-aabb-overlap: Fast Sphere vs AABB Overlap Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sphere_overlaps_aabb(cx: float, cy: float, cz: float, r: float, min_b: vector[float], max_b: vector[float]) -> int:
    dsq := 0.0
    c: vector[float] := [cx, cy, cz]
    i := 0
    while i < 3:
        val := c[i]
        if val < min_b[i]:
            d := min_b[i] - val
            dsq = dsq + d * d
        if val > max_b[i]:
            d := val - max_b[i]
            dsq = dsq + d * d
        i = i + 1
    if dsq <= (r * r): return 1
    return 0
