// cl-sphere-aabb-overlap: Test Suite
import "../sphere_aabb_overlap.zk"

fn test_sphere_aabb_overlap():
    min_b: vector[float] := [0.0, 0.0, 0.0]
    max_b: vector[float] := [10.0, 10.0, 10.0]
    hit := sphere_overlaps_aabb(12.0, 5.0, 5.0, 3.0, min_b, max_b)
    if hit != 1: sys_exit(1)
    miss := sphere_overlaps_aabb(15.0, 5.0, 5.0, 3.0, min_b, max_b)
    if miss != 0: sys_exit(1)
    print("test_sphere_aabb_overlap passed: sphere AABB overlap verified")

fn main():
    test_sphere_aabb_overlap()
    print("✓ All tests passed for cl-sphere-aabb-overlap!")
