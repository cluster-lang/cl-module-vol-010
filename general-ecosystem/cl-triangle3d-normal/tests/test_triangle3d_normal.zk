// cl-triangle3d-normal: Test Suite
import "../tri_norm.zk"

fn test_tri_norm():
    v0: vector[float] := [0.0, 0.0, 0.0]
    v1: vector[float] := [1.0, 0.0, 0.0]
    v2: vector[float] := [0.0, 1.0, 0.0]
    n: vector[float] := []
    triangle3d_normal(n, v0, v1, v2)
    if n[2] != 1.0: sys_exit(1)
    print("test_tri_norm passed: triangle normal z=1.0 verified")

fn main():
    test_tri_norm()
    print("✓ All tests passed for cl-triangle3d-normal!")
