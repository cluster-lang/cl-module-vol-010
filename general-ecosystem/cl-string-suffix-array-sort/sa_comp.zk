// cl-string-suffix-array-sort: Suffix Substring Comparator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

// Returns -1 if suffix at idx1 < suffix at idx2, 1 if >, 0 if equal
fn suffix_compare(s: string, idx1: int, idx2: int) -> int:
    slen := len(s)
    p1 := idx1
    p2 := idx2
    while p1 < slen:
        if p2 >= slen: return 1
        c1 := byte_at(s, p1)
        c2 := byte_at(s, p2)
        if c1 < c2: return -1
        if c1 > c2: return 1
        p1 = p1 + 1
        p2 = p2 + 1
    if p2 < slen: return -1
    return 0
