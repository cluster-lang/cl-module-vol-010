// cl-vec14-max-element: 14D Vector Maximum Component
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec14_max(a: vector[float]) -> float:
    max := a[0]
    i := 1
    while i < 14:
        if a[i] > max: max = a[i]
        i = i + 1
    return max
