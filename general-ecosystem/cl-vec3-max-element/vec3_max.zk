// cl-vec3-max-element: 3D Vector Maximum Element
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_max_element(v: vector[float]) -> float:
    max_v := v[0]
    if v[1] > max_v: max_v = v[1]
    if v[2] > max_v: max_v = v[2]
    return max_v
