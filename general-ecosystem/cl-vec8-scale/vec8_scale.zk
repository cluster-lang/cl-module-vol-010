// cl-vec8-scale: 8D Vector Scalar Multiplication
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec8_scale(out: vector[float], v: vector[float], s: float):
    i := 0
    while i < 8:
        out[i] = v[i] * s
        i = i + 1
