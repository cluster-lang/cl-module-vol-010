// cl-vec4-mean: Test Suite
import "../vec4_mean.zk"

fn test_v4_mean():
    v: vector[float] := [10.0, 20.0, 30.0, 40.0]
    res := vec4_mean(v)
    diff := res - 25.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v4_mean passed")

fn main():
    test_v4_mean()
    print("✓ All tests passed for cl-vec4-mean!")
