// cl-vec8-chebyshev-norm: 8D Vector L-infinity Chebyshev Norm
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec8_chebyshev_norm(v: vector[float]) -> float:
    max_v := 0.0
    i := 0
    while i < 8:
        x := v[i]
        if x < 0.0: x = 0.0 - x
        if x > max_v: max_v = x
        i = i + 1
    return max_v
