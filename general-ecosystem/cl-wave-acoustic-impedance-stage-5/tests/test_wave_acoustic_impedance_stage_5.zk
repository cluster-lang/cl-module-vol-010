// cl-wave-acoustic-impedance-stage-5: Test Suite
import "../ac_imp_5.zk"

fn test_run():
    res := acoustic_impedance_5(1.2, 343.0)
    diff := res - 2058.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-acoustic-impedance-stage-5!")
