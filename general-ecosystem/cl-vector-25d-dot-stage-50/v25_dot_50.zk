// cl-vector-25d-dot-stage-50: 25D Vector Dot Product Stage 50
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec25_dot_50(a: vector[float], b: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 25:
        s = s + a[i] * b[i]
        i = i + 1
    return s * 50.0
