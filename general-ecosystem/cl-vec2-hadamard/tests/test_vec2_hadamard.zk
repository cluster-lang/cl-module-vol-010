// cl-vec2-hadamard: Test Suite
import "../vec2_had.zk"

fn test_v2_had():
    a: vector[float] := [3.0, 4.0]
    b: vector[float] := [5.0, 6.0]
    out: vector[float] := [0.0, 0.0]
    vec2_hadamard(out, a, b)
    if out[0] != 15.0 or out[1] != 24.0: sys_exit(1)
    print("test_v2_had passed")

fn main():
    test_v2_had()
    print("✓ All tests passed for cl-vec2-hadamard!")
