// cl-vec2-hadamard: 2D Vector Component-wise Multiplication
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_hadamard(out: vector[float], a: vector[float], b: vector[float]):
    out[0] = a[0] * b[0]
    out[1] = a[1] * b[1]
