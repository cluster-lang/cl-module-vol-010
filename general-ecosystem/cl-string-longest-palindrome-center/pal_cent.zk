// cl-string-longest-palindrome-center: Expand Around Center Radius
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn expand_palindrome_radius(s: string, left: int, right: int) -> int:
    l := left
    r := right
    slen := len(s)
    while l >= 0:
        if r >= slen: return (r - l - 1)
        if byte_at(s, l) != byte_at(s, r): return (r - l - 1)
        l = l - 1
        r = r + 1
    return (r - l - 1)
