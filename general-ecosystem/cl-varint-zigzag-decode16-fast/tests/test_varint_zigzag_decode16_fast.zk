// cl-varint-zigzag-decode16-fast: Test Suite
import "../zz16_dec.zk"

fn test_zz16_dec():
    if zigzag_decode16_fast(0) != 0: sys_exit(1)
    if zigzag_decode16_fast(1) != -1: sys_exit(2)
    if zigzag_decode16_fast(2) != 1: sys_exit(3)
    if zigzag_decode16_fast(3) != -2: sys_exit(4)
    print("test_zz16_dec passed: 16-bit zigzag decoding verified")

fn main():
    test_zz16_dec()
    print("✓ All tests passed for cl-varint-zigzag-decode16-fast!")
