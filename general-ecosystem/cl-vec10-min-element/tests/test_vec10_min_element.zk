// cl-vec10-min-element: Test Suite
import "../v10_min.zk"

fn test_run():
    res := vec10_min([10.0, 9.0, 8.0, 7.0, 1.0, 5.0, 4.0, 3.0, 2.0, 6.0])
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-vec10-min-element!")
