// cl-thermo-ideal-gas-stage-18: Test Suite
import "../gas_pr_18.zk"

fn test_run():
    res := ideal_gas_pressure_18(1.0, 300.0, 1.0)
    diff := res - 44898.0948
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-thermo-ideal-gas-stage-18!")
