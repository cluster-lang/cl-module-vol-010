// cl-vec2-manhattan-norm: Test Suite
import "../vec2_man_norm.zk"

fn test_v2_man_norm():
    v: vector[float] := [-3.5, 4.5]
    res := vec2_manhattan_norm(v)
    diff := res - 8.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_man_norm passed")

fn main():
    test_v2_man_norm()
    print("✓ All tests passed for cl-vec2-manhattan-norm!")
