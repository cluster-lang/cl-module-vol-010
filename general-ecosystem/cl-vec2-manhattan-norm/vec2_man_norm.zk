// cl-vec2-manhattan-norm: 2D Vector L1 Manhattan Norm
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_manhattan_norm(v: vector[float]) -> float:
    x := v[0]
    if x < 0.0: x = 0.0 - x
    y := v[1]
    if y < 0.0: y = 0.0 - y
    return x + y
