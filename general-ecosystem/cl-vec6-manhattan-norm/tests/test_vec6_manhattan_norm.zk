// cl-vec6-manhattan-norm: Test Suite
import "../vec6_man.zk"

fn test_v6_man():
    v: vector[float] := [-3.0, -3.0, -3.0, -3.0, -3.0, -3.0]
    res := vec6_manhattan_norm(v)
    diff := res - 18.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v6_man passed")

fn main():
    test_v6_man()
    print("✓ All tests passed for cl-vec6-manhattan-norm!")
