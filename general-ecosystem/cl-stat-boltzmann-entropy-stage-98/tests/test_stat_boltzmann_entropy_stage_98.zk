// cl-stat-boltzmann-entropy-stage-98: Test Suite
import "../boltz_s_98.zk"

fn test_run():
    res := boltzmann_entropy_factor_98(10.0)
    diff := res - 1353.0360
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-entropy-stage-98!")
