// Collects match indices from Z-array of concatenated pattern$text
fn collect_z_matches(z: vector[int], pat_len: int, out: vector[int]):
    n := z.len()
    i := pat_len + 1
    while i < n:
        if z[i] == pat_len:
            out.push(i - pat_len - 1)
        i = i + 1
