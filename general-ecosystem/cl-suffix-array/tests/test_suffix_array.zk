// cl-suffix-array: Test Suite
import "../suffix_array.zk"

fn test_suffix_array():
    sa := build_suffix_array("banana")
    // "banana" sorted suffixes:
    // 5: "a"
    // 3: "ana"
    // 1: "anana"
    // 0: "banana"
    // 4: "na"
    // 2: "nana"
    if sa[0] != 5: sys_exit(1)
    if sa[1] != 3: sys_exit(1)
    if sa[2] != 1: sys_exit(1)
    if sa[3] != 0: sys_exit(1)
    if sa[4] != 4: sys_exit(1)
    if sa[5] != 2: sys_exit(1)
    print("test_suffix_array passed: lexicographical suffix ordering verified")

fn main():
    test_suffix_array()
    print("✓ All tests passed for cl-suffix-array!")
