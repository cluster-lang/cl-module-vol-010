// cl-stat-boltzmann-entropy-stage-62: Test Suite
import "../boltz_s_62.zk"

fn test_run():
    res := boltzmann_entropy_factor_62(10.0)
    diff := res - 856.0024
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-entropy-stage-62!")
