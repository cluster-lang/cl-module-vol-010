// cl-stat-lennard-jones-ratio-stage-15: Test Suite
import "../lj_rt_15.zk"

fn test_run():
    res := lj_inv_r6_15(1.0)
    diff := res - 15.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-lennard-jones-ratio-stage-15!")
