// cl-vec3-chebyshev-norm: Test Suite
import "../vec3_cheb_norm.zk"

fn test_v3_cheb_norm():
    v: vector[float] := [-2.0, 8.0, -5.0]
    res := vec3_chebyshev_norm(v)
    diff := res - 8.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v3_cheb_norm passed")

fn main():
    test_v3_cheb_norm()
    print("✓ All tests passed for cl-vec3-chebyshev-norm!")
