// cl-z-algorithm: Linear O(N) Z-Box Substring Search
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn z_algorithm_compute(s: string) -> vector[int]:
    n := len(s)
    z: vector[int] := []
    i := 0
    while i < n:
        z.push(0)
        i = i + 1

    l := 0
    r := 0
    i = 1
    while i < n:
        if i <= r:
            prev_z := z[i - l]
            rem := (r - i) + 1
            if prev_z < rem:
                z[i] = prev_z
            else:
                z[i] = rem
        while (i + z[i]) < n:
            if byte_at(s, z[i]) == byte_at(s, i + z[i]):
                z[i] = z[i] + 1
            else:
                break
        if ((i + z[i]) - 1) > r:
            l = i
            r = (i + z[i]) - 1
        i = i + 1
    return z
