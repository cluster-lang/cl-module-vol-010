// cl-string-jaro-metric-exact-score: Test Suite
import "../jaro_score.zk"

fn test_jaro_score():
    s1 := jaro_similarity_score(2, 0, 2, 2) // Perfect match -> 1.0
    diff := s1 - 1.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_jaro_score passed")

fn main():
    test_jaro_score()
    print("✓ All tests passed for cl-string-jaro-metric-exact-score!")
