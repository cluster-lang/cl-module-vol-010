// cl-vec11-min-element: 11D Vector Minimum Component
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec11_min(a: vector[float]) -> float:
    min := a[0]
    i := 1
    while i < 11:
        if a[i] < min: min = a[i]
        i = i + 1
    return min
