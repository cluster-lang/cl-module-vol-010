// cl-vlq-stream-byte-count: VLQ Varint Encoded Stream Length
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vlq_stream_total_bytes(values: vector[int]) -> int:
    total := 0
    n := values.len()
    i := 0
    while i < n:
        v := values[i]
        if v < 128: total = total + 1
        else: total = total + 2
        i = i + 1
    return total
