fn stats_variance(v: vector[float]) -> float:
    n := v.len()
    if n <= 1: return 0.0
    sum := 0.0
    i := 0
    while i < n:
        sum = sum + v[i]
        i = i + 1
    mean := sum / float(n)
    sum_sq := 0.0
    i = 0
    while i < n:
        d := v[i] - mean
        sum_sq = sum_sq + d * d
        i = i + 1
    return sum_sq / float(n - 1)
