// cl-vec4-chebyshev-norm: 4D Vector L-infinity Chebyshev Norm
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec4_chebyshev_norm(v: vector[float]) -> float:
    x := v[0]; if x < 0.0: x = 0.0 - x
    y := v[1]; if y < 0.0: y = 0.0 - y
    z := v[2]; if z < 0.0: z = 0.0 - z
    w := v[3]; if w < 0.0: w = 0.0 - w
    max_v := x
    if y > max_v: max_v = y
    if z > max_v: max_v = z
    if w > max_v: max_v = w
    return max_v
