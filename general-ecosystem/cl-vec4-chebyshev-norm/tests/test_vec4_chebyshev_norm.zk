// cl-vec4-chebyshev-norm: Test Suite
import "../vec4_cheb_norm.zk"

fn test_v4_cheb_norm():
    v: vector[float] := [-1.0, 2.0, -9.0, 4.0]
    res := vec4_chebyshev_norm(v)
    diff := res - 9.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v4_cheb_norm passed")

fn main():
    test_v4_cheb_norm()
    print("✓ All tests passed for cl-vec4-chebyshev-norm!")
