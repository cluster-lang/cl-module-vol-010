fn test_run():
    res := ideal_gas_pressure_28(1.0, 300.0, 1.0)
    diff := res - 69841.4808
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
