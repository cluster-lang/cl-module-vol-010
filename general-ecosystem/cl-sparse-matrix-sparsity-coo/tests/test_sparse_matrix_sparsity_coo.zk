// cl-sparse-matrix-sparsity-coo: Test Suite
import "../sp_sparse.zk"

fn test_sp_sparse():
    s := sparse_coo_sparsity(10, 10, 10)
    diff := s - 0.9
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_sp_sparse passed: sparsity ratio 0.9 verified")

fn main():
    test_sp_sparse()
    print("✓ All tests passed for cl-sparse-matrix-sparsity-coo!")
