// cl-vec4: Pure Cluster 4D Vector Mathematics
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

model Vec4:
    x: int
    y: int
    z: int
    w: int

fn vec4_add(a: Vec4, b: Vec4) -> Vec4:
    return Vec4(a.x + b.x, a.y + b.y, a.z + b.z, a.w + b.w)

fn vec4_sub(a: Vec4, b: Vec4) -> Vec4:
    return Vec4(a.x - b.x, a.y - b.y, a.z - b.z, a.w - b.w)

fn vec4_dot(a: Vec4, b: Vec4) -> int:
    return (a.x * b.x) + (a.y * b.y) + (a.z * b.z) + (a.w * b.w)

fn vec4_len_sq(a: Vec4) -> int:
    return vec4_dot(a, a)
