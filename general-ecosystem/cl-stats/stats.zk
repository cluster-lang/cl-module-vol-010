fn stats_sum(vals: vector[int]) -> int:
    s := 0
    i := 0
    vlen := vals.len()
    while i < vlen:
        s = s + vals[i]
        i = i + 1
    return s

fn stats_mean(vals: vector[int]) -> int:
    vlen := vals.len()
    if vlen == 0: return 0
    return stats_sum(vals) / vlen

fn stats_min(vals: vector[int]) -> int:
    vlen := vals.len()
    if vlen == 0: return 0
    m := vals[0]
    i := 1
    while i < vlen:
        if vals[i] < m:
            m = vals[i]
        i = i + 1
    return m

fn stats_max(vals: vector[int]) -> int:
    vlen := vals.len()
    if vlen == 0: return 0
    m := vals[0]
    i := 1
    while i < vlen:
        if vals[i] > m:
            m = vals[i]
        i = i + 1
    return m

fn stats_variance(vals: vector[int]) -> int:
    vlen := vals.len()
    if vlen <= 1: return 0
    mu := stats_mean(vals)
    var_sum := 0
    i := 0
    while i < vlen:
        diff := vals[i] - mu
        var_sum = var_sum + (diff * diff)
        i = i + 1
    return var_sum / vlen
