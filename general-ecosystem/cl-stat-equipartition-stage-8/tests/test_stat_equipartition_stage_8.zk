// cl-stat-equipartition-stage-8: Test Suite
import "../eq_en_8.zk"

fn test_run():
    res := equipartition_energy_8(100.0)
    diff := res - 552.2596
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-equipartition-stage-8!")
