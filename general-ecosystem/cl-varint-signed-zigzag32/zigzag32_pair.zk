// cl-varint-signed-zigzag32: 32-bit ZigZag Transform Engine
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn zigzag32_encode_val(n: int) -> int:
    mask32 := 4294967295
    return ((n << 1) ^ (n >> 31)) & mask32

fn zigzag32_decode_val(n: int) -> int:
    un := n & 4294967295
    half := (un >> 1) & 2147483647
    if (un & 1) == 1:
        return 0 - (half + 1)
    return half
