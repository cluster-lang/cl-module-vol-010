// cl-vec4-max-element: 4D Vector Maximum Element
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec4_max_element(v: vector[float]) -> float:
    max_v := v[0]
    if v[1] > max_v: max_v = v[1]
    if v[2] > max_v: max_v = v[2]
    if v[3] > max_v: max_v = v[3]
    return max_v
