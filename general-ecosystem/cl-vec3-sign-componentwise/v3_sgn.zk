// cl-vec3-sign-componentwise: Componentwise Signum Function for 3D Vector
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_sign(v: vector[float]) -> vector[float]:
    sx := 0.0
    sy := 0.0
    sz := 0.0
    if v[0] > 0.0: sx = 1.0
    if v[0] < 0.0: sx = -1.0
    if v[1] > 0.0: sy = 1.0
    if v[1] < 0.0: sy = -1.0
    if v[2] > 0.0: sz = 1.0
    if v[2] < 0.0: sz = -1.0
    return [sx, sy, sz]
