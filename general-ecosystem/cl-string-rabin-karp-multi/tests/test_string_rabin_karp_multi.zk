// cl-string-rabin-karp-multi: Test Suite
import "../rk_multi.zk"

fn test_rk_multi():
    t: vector[int] := [65, 66, 67, 68] // "ABCD"
    p: vector[int] := [66, 67]         // "BC"
    if rabin_karp_check_match(t, 1, p) != 1: sys_exit(1)
    if rabin_karp_check_match(t, 0, p) != 0: sys_exit(1)
    print("test_rk_multi passed: pattern exact match check verified")

fn main():
    test_rk_multi()
    print("✓ All tests passed for cl-string-rabin-karp-multi!")
