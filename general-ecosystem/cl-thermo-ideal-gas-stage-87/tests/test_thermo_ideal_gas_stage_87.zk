// cl-thermo-ideal-gas-stage-87: Test Suite
import "../gas_pr_87.zk"

fn test_run():
    res := ideal_gas_pressure_87(1.0, 300.0, 1.0)
    diff := res - 217007.4582
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-thermo-ideal-gas-stage-87!")
