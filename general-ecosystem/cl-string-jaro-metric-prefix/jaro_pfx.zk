// cl-string-jaro-metric-prefix: Common Prefix Length Calculator for Jaro-Winkler
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn common_prefix_length(s1: vector[int], s2: vector[int], max_pfx: int) -> int:
    lim := s1.len()
    if s2.len() < lim: lim = s2.len()
    if lim > max_pfx: lim = max_pfx

    pfx := 0
    while pfx < lim and s1[pfx] == s2[pfx]:
        pfx = pfx + 1
    return pfx
