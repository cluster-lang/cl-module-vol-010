// cl-string-jaro-metric-prefix: Test Suite
import "../jaro_pfx.zk"

fn test_jaro_pfx():
    s1: vector[int] := [65, 66, 67, 68]
    s2: vector[int] := [65, 66, 67, 69]
    p := common_prefix_length(s1, s2, 4)
    if p != 3: sys_exit(1)
    print("test_jaro_pfx passed: common prefix length 3 verified")

fn main():
    test_jaro_pfx()
    print("✓ All tests passed for cl-string-jaro-metric-prefix!")
