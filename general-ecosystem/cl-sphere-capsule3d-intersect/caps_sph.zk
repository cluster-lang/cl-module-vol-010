// cl-sphere-capsule3d-intersect: Sphere-to-Capsule 3D Collision Test
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sphere_capsule3d_overlap(sx: float, sy: float, sz: float, s_radius: float, ax: float, ay: float, az: float, bx: float, by: float, bz: float, cap_radius: float) -> int:
    abx := bx - ax
    aby := by - ay
    abz := bz - az
    asx := sx - ax
    asy := sy - ay
    asz := sz - az
    ab_len_sq := abx * abx + aby * aby + abz * abz

    t := 0.0
    if ab_len_sq > 0.0:
        t = (asx * abx + asy * aby + asz * abz) / ab_len_sq
    if t < 0.0: t = 0.0
    if t > 1.0: t = 1.0

    closest_x := ax + t * abx
    closest_y := ay + t * aby
    closest_z := az + t * abz

    dx := sx - closest_x
    dy := sy - closest_y
    dz := sz - closest_z
    dist_sq := dx * dx + dy * dy + dz * dz
    r_sum := s_radius + cap_radius

    if dist_sq <= r_sum * r_sum:
        return 1
    return 0
