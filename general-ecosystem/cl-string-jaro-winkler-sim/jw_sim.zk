// cl-string-jaro-winkler-sim: Jaro-Winkler Metric with Prefix Scaling
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn jaro_winkler_sim(s1: vector[int], s2: vector[int], jaro_score: float) -> float:
    min_len := s1.len()
    if s2.len() < min_len: min_len = s2.len()
    if min_len > 4: min_len = 4

    prefix := 0
    while prefix < min_len and s1[prefix] == s2[prefix]:
        prefix = prefix + 1

    p := 0.1
    return jaro_score + float(prefix) * p * (1.0 - jaro_score)
