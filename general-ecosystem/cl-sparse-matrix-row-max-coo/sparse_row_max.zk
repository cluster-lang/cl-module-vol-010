// cl-sparse-matrix-row-max-coo: COO Sparse Matrix Row Maximum Entry
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sparse_coo_row_max(rows: vector[int], vals: vector[int], target_row: int) -> int:
    max_val := -2147483648
    found := 0
    i := 0
    nnz := rows.len()
    while i < nnz:
        if rows[i] == target_row:
            if found == 0:
                max_val = vals[i]
                found = 1
            else:
                if vals[i] > max_val:
                    max_val = vals[i]
        i = i + 1
    if found == 0: return 0
    return max_val
