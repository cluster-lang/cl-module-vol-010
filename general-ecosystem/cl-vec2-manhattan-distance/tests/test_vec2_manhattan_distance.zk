// cl-vec2-manhattan-distance: Test Suite
import "../vec2_man_dist.zk"

fn test_v2_man_dist():
    a: vector[float] := [1.0, 2.0]
    b: vector[float] := [5.0, 8.0]
    res := vec2_manhattan_distance(a, b)
    diff := res - 10.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_man_dist passed")

fn main():
    test_v2_man_dist()
    print("✓ All tests passed for cl-vec2-manhattan-distance!")
