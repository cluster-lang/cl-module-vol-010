// cl-sphere-cone-cull: Test Suite
import "../sphere_cone.zk"

fn test_sphere_cone():
    if sphere_cone_cull_test(0.0, 0.0, 5.0, 2.0, 10.0, 5.0) != 1: sys_exit(1)
    if sphere_cone_cull_test(0.0, 0.0, 20.0, 2.0, 10.0, 5.0) != 0: sys_exit(1)
    print("test_sphere_cone passed: sphere cone culling verified")

fn main():
    test_sphere_cone()
    print("✓ All tests passed for cl-sphere-cone-cull!")
