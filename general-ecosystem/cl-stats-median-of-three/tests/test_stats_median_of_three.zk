// cl-stats-median-of-three: Test Suite
import "../st_med3.zk"

fn test_st_med3():
    if stats_median_three(1.0, 5.0, 3.0) != 3.0: sys_exit(1)
    if stats_median_three(9.0, 2.0, 7.0) != 7.0: sys_exit(1)
    print("test_st_med3 passed")

fn main():
    test_st_med3()
    print("✓ All tests passed for cl-stats-median-of-three!")
