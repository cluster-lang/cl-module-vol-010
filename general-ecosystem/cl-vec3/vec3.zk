// cl-vec3: Pure Cluster 3D Vector Mathematics
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

model Vec3:
    x: int
    y: int
    z: int

fn vec3_add(a: Vec3, b: Vec3) -> Vec3:
    return Vec3(a.x + b.x, a.y + b.y, a.z + b.z)

fn vec3_sub(a: Vec3, b: Vec3) -> Vec3:
    return Vec3(a.x - b.x, a.y - b.y, a.z - b.z)

fn vec3_scale(a: Vec3, s: int) -> Vec3:
    return Vec3(a.x * s, a.y * s, a.z * s)

fn vec3_dot(a: Vec3, b: Vec3) -> int:
    return (a.x * b.x) + (a.y * b.y) + (a.z * b.z)

fn vec3_cross(a: Vec3, b: Vec3) -> Vec3:
    return Vec3(
        (a.y * b.z) - (a.z * b.y),
        (a.z * b.x) - (a.x * b.z),
        (a.x * b.y) - (a.y * b.x)
    )

fn vec3_len_sq(a: Vec3) -> int:
    return vec3_dot(a, a)
