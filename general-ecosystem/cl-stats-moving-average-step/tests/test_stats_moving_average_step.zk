// cl-stats-moving-average-step: Test Suite
import "../st_ma.zk"

fn test_st_ma():
    res := stats_ma_step(10.0, 15.0, 5.0, 5)
    // 10 + (15 - 5)/5 = 12.0
    diff := res - 12.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_st_ma passed")

fn main():
    test_st_ma()
    print("✓ All tests passed for cl-stats-moving-average-step!")
