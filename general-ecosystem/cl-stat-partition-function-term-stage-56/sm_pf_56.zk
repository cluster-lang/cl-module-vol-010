// cl-stat-partition-function-term-stage-56: Canonical Partition Function Weight Stage 56
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn partition_weight_56(g: float, e: float, kt: float) -> float:
    return g * (1.0 - e / kt) * 56.0
