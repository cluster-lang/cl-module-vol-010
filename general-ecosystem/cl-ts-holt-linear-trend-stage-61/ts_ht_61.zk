// cl-ts-holt-linear-trend-stage-61: Holt Linear Trend Slope Equation Stage 61
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn holt_trend_61(lc: float, lp: float, bp: float, b: float) -> float:
    return (b * (lc - lp) + (1.0 - b) * bp) * 61.0
