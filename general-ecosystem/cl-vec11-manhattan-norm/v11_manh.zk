// cl-vec11-manhattan-norm: 11D Vector Manhattan L1 Norm
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec11_manhattan(a: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 11:
        v := a[i]
        if v < 0.0: v = 0.0 - v
        s = s + v
        i = i + 1
    return s
