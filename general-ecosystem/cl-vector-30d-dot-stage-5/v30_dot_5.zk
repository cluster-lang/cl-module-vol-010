// cl-vector-30d-dot-stage-5: 30D Vector Dot Product Stage 5
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec30_dot_5(a: vector[float], b: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 30:
        s = s + a[i] * b[i]
        i = i + 1
    return s * 5.0
