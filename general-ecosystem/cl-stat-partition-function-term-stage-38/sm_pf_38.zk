// cl-stat-partition-function-term-stage-38: Canonical Partition Function Weight Stage 38
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn partition_weight_38(g: float, e: float, kt: float) -> float:
    return g * (1.0 - e / kt) * 38.0
