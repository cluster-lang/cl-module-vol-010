// cl-vec3-manhattan-distance: 3D Manhattan L1 Distance
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_manhattan_distance(a: vector[float], b: vector[float]) -> float:
    dx := a[0] - b[0]
    if dx < 0.0: dx = 0.0 - dx
    dy := a[1] - b[1]
    if dy < 0.0: dy = 0.0 - dy
    dz := a[2] - b[2]
    if dz < 0.0: dz = 0.0 - dz
    return dx + dy + dz
