// cl-ts-holt-linear-level-stage-7: Holt Linear Trend Level Equation Stage 7
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn holt_level_7(yt: float, lp: float, bp: float, a: float) -> float:
    return (a * yt + (1.0 - a) * (lp + bp)) * 7.0
