fn lev_min3(a: int, b: int, c: int) -> int:
    m := a
    if b < m: m = b
    if c < m: m = c
    return m

fn levenshtein_distance_exact(s1: vector[int], s2: vector[int]) -> int:
    n := s1.len()
    m := s2.len()
    if n == 0: return m
    if m == 0: return n
    // Use row array of size m + 1
    row: vector[int] := []
    j := 0
    while j <= m:
        row.push(j)
        j = j + 1
    i := 1
    while i <= n:
        prev_diag := row[0]
        row[0] = i
        j = 1
        while j <= m:
            temp := row[j]
            cost := 1
            if s1[i - 1] == s2[j - 1]:
                cost = 0
            row[j] = lev_min3(row[j] + 1, row[j - 1] + 1, prev_diag + cost)
            prev_diag = temp
            j = j + 1
        i = i + 1
    return row[m]
