// cl-vec10-norm-squared: 10D Vector Squared Euclidean Norm
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec10_norm_sq(a: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 10:
        s = s + a[i] * a[i]
        i = i + 1
    return s
