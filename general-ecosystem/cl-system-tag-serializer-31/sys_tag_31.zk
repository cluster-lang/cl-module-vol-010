// cl-system-tag-serializer-31: System Binary Serialization Tag Marker 31
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sys_serialize_tag_31(base_tag: int) -> int:
    mask32 := 4294967295
    return (base_tag + 31000) & mask32
