fn rotl64(x: int, b: int) -> int:
    mask := (1 << b) - 1
    right := (x >> (64 - b)) & mask
    left := x << b
    return left | right

fn xxh64_round(acc: int, input_val: int) -> int:
    // P1 = 0x9E3779B185EBCA87 -> -7046029254386353017
    // P2 = 0xC2B2AE3D27D4EB4F -> -4417276706817148081
    p1 := -7046029254386353017
    p2 := -4417276706817148081
    res := acc + (input_val * p2)
    res = rotl64(res, 31)
    return res * p1
