// cl-vec3-scale: 3D Vector Scalar Multiplication
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_scale(out: vector[float], v: vector[float], s: float):
    out[0] = v[0] * s
    out[1] = v[1] * s
    out[2] = v[2] * s
