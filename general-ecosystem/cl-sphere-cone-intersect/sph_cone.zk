// cl-sphere-cone-intersect: 3D Bounding Sphere and Cone Overlap Test
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sphere_cone_intersect(cx: float, cy: float, cz: float, r: float, cone_h: float, cone_r: float) -> int:
    // Check if sphere overlaps cone of height [0, cone_h] around Z axis
    if cz < (0.0 - r) or cz > (cone_h + r):
        return 0
    xy_dist_sq := cx * cx + cy * cy
    max_r := cone_r + r
    if xy_dist_sq > max_r * max_r:
        return 0
    return 1
