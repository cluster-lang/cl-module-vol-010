import "../mfp_cp_31.zk"

fn test_run():
    res := mean_free_path_comp_31(1.0, 1.0)
    diff := res - 6.9775
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
