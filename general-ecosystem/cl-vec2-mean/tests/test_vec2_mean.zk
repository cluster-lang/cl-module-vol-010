// cl-vec2-mean: Test Suite
import "../vec2_mean.zk"

fn test_v2_mean():
    v: vector[float] := [10.0, 30.0]
    res := vec2_mean(v)
    diff := res - 20.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_mean passed")

fn main():
    test_v2_mean()
    print("✓ All tests passed for cl-vec2-mean!")
