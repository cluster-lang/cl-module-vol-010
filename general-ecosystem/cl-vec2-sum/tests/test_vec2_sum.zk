// cl-vec2-sum: Test Suite
import "../vec2_sum.zk"

fn test_v2_sum():
    v: vector[float] := [12.5, 7.5]
    res := vec2_sum(v)
    diff := res - 20.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_sum passed")

fn main():
    test_v2_sum()
    print("✓ All tests passed for cl-vec2-sum!")
