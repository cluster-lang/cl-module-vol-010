// cl-thermo-ideal-gas-stage-74: Test Suite
import "../gas_pr_74.zk"

fn test_run():
    res := ideal_gas_pressure_74(1.0, 300.0, 1.0)
    diff := res - 184581.0564
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
