// cl-stat-boltzmann-prob-stage-77: Boltzmann State Probability Ratio Stage 77
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn boltzmann_ratio_77(e1: float, e2: float, kt: float) -> float:
    return (1.0 - (e1 - e2) / kt) * 77.0
