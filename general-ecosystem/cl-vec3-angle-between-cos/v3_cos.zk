// cl-vec3-angle-between-cos: Cosine of Angle Between Two 3D Vectors
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_angle_cos(u: vector[float], v: vector[float]) -> float:
    dot := u[0]*v[0] + u[1]*v[1] + u[2]*v[2]
    sq := (u[0]*u[0] + u[1]*u[1] + u[2]*u[2]) * (v[0]*v[0] + v[1]*v[1] + v[2]*v[2])
    if sq <= 0.000001: return 1.0
    guess := sq * 0.5
    iter := 0
    while iter < 6:
        guess = (guess + sq / guess) * 0.5
        iter = iter + 1
    return dot / guess
