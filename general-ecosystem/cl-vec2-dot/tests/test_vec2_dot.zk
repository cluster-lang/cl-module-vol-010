// cl-vec2-dot: Test Suite
import "../vec2_dot.zk"

fn test_v2_dot():
    a: vector[float] := [2.0, 3.0]
    b: vector[float] := [4.0, 5.0]
    // 2*4 + 3*5 = 8 + 15 = 23.0
    res := vec2_dot(a, b)
    diff := res - 23.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v2_dot passed")

fn main():
    test_v2_dot()
    print("✓ All tests passed for cl-vec2-dot!")
