// cl-stats-euclidean-norm-sample: Test Suite
import "../st_enorm.zk"

fn test_st_enorm():
    v: vector[float] := [3.0, 4.0]
    res := stats_euclidean_norm(v)
    diff := res - 5.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_st_enorm passed")

fn main():
    test_st_enorm()
    print("✓ All tests passed for cl-stats-euclidean-norm-sample!")
