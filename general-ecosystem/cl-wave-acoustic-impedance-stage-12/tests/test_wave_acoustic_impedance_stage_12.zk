// cl-wave-acoustic-impedance-stage-12: Test Suite
import "../ac_imp_12.zk"

fn test_run():
    res := acoustic_impedance_12(1.2, 343.0)
    diff := res - 4939.2000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-acoustic-impedance-stage-12!")
