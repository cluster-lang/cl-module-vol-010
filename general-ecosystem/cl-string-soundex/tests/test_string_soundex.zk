// cl-string-soundex: Test Suite
import "../soundex.zk"

fn test_soundex():
    if soundex_digit(66) != 1: sys_exit(1) // 'B' -> 1
    if soundex_digit(67) != 2: sys_exit(1) // 'C' -> 2
    if soundex_digit(68) != 3: sys_exit(1) // 'D' -> 3
    if soundex_digit(76) != 4: sys_exit(1) // 'L' -> 4
    if soundex_digit(77) != 5: sys_exit(1) // 'M' -> 5
    if soundex_digit(82) != 6: sys_exit(1) // 'R' -> 6
    print("test_soundex passed: phonetic Soundex mapping verified")

fn main():
    test_soundex()
    print("✓ All tests passed for cl-string-soundex!")
