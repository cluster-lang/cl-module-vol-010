// cl-vector-27d-dot-stage-12: 27D Vector Dot Product Stage 12
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec27_dot_12(a: vector[float], b: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 27:
        s = s + a[i] * b[i]
        i = i + 1
    return s * 12.0
