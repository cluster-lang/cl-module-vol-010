fn max2(a: int, b: int) -> int:
    if a > b: return a
    return b

fn lcs_length(s1: string, s2: string) -> int:
    m := len(s1)
    n := len(s2)
    stride := n + 1
    dp: vector[int] := []
    total := (m + 1) * (n + 1)
    i := 0
    while i < total:
        dp.push(0)
        i = i + 1

    i = 1
    j := 1
    while i <= m:
        j = 1
        while j <= n:
            if byte_at(s1, i - 1) == byte_at(s2, j - 1):
                dp[(i * stride) + j] = dp[((i - 1) * stride) + (j - 1)] + 1
            else:
                dp[(i * stride) + j] = max2(dp[((i - 1) * stride) + j], dp[(i * stride) + (j - 1)])
            j = j + 1
        i = i + 1
    return dp[(m * stride) + n]
