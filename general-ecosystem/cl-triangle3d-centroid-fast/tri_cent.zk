fn triangle3d_centroid_fast(out: vector[float], v0: vector[float], v1: vector[float], v2: vector[float]):
    i := 0
    while i < 3:
        out.push((v0[i] + v1[i] + v2[i]) / 3.0)
        i = i + 1
