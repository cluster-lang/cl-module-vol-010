// cl-sweep-line: 2D Event Point Coordinate Comparator
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sweep_event_cmp(x1: int, y1: int, x2: int, y2: int) -> int:
    if x1 < x2: return -1
    if x1 > x2: return 1
    if y1 < y2: return -1
    if y1 > y2: return 1
    return 0
