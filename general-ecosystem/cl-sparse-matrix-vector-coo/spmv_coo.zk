// triplets: flat [row, col, val, ...]
fn spmv_coo(triplets: vector[int], x: vector[int], y: vector[int]):
    n := triplets.len() / 3
    i := 0
    while i < n:
        r := triplets[i * 3]
        c := triplets[(i * 3) + 1]
        v := triplets[(i * 3) + 2]
        y[r] = y[r] + (v * x[c])
        i = i + 1
