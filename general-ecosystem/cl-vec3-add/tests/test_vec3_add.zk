// cl-vec3-add: Test Suite
import "../vec3_add.zk"

fn test_v3_add():
    a: vector[float] := [1.0, 2.0, 3.0]
    b: vector[float] := [4.0, 5.0, 6.0]
    out: vector[float] := [0.0, 0.0, 0.0]
    vec3_add(out, a, b)
    if out[0] != 5.0 or out[1] != 7.0 or out[2] != 9.0: sys_exit(1)
    print("test_v3_add passed")

fn main():
    test_v3_add()
    print("✓ All tests passed for cl-vec3-add!")
