// cl-wave-intensity-flux-stage-17: Test Suite
import "../ac_int_17.zk"

fn test_run():
    res := wave_intensity_17(20.0, 400.0)
    diff := res - 17.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-wave-intensity-flux-stage-17!")
