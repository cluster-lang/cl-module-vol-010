// cl-string-levenshtein-transposition-step: Adjacent Character Transposition Detector
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn is_damerau_transposition(c1: int, c2: int, d1: int, d2: int) -> int:
    if c1 == d2 and c2 == d1 and c1 != c2:
        return 1
    return 0
