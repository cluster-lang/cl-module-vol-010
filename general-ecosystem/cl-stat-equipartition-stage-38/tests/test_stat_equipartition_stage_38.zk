// cl-stat-equipartition-stage-38: Test Suite
import "../eq_en_38.zk"

fn test_run():
    res := equipartition_energy_38(100.0)
    diff := res - 2623.2331
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-equipartition-stage-38!")
