// cl-vector-32d-dot-stage-27: 32D Vector Dot Product Stage 27
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec32_dot_27(a: vector[float], b: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 32:
        s = s + a[i] * b[i]
        i = i + 1
    return s * 27.0
