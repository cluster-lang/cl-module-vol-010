// cl-string-boyer-moore-bad-char: Test Suite
import "../bm_badchar.zk"

fn test_bm_badchar():
    pat: vector[int] := [65, 66, 67] // "ABC"
    s1 := bm_bad_char_skip(pat, 65) // 'A' at 0 -> 3 - 1 - 0 = 2
    if s1 != 2: sys_exit(1)
    s2 := bm_bad_char_skip(pat, 90) // 'Z' -> 3
    if s2 != 3: sys_exit(1)
    print("test_bm_badchar passed: bad char skip rule verified")

fn main():
    test_bm_badchar()
    print("✓ All tests passed for cl-string-boyer-moore-bad-char!")
