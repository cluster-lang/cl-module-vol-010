// cl-string-boyer-moore-bad-char: Boyer-Moore Bad Character Skip Table
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn bm_bad_char_skip(pat: vector[int], bad_char: int) -> int:
    plen := pat.len()
    i := plen - 1
    found := 0
    last_idx := -1
    while i >= 0:
        if pat[i] == bad_char:
            if found == 0:
                last_idx = i
                found = 1
        i = i - 1
    if found == 1:
        skip := plen - 1 - last_idx
        if skip < 1: return 1
        return skip
    return plen
