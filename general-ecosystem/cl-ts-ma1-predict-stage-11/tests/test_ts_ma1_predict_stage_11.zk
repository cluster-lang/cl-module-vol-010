// cl-ts-ma1-predict-stage-11: Test Suite
import "../ts_ma_11.zk"

fn test_run():
    res := ma1_step_11(5.0, 0.5, 2.0)
    diff := res - 66.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-ts-ma1-predict-stage-11!")
