// cl-sparse-matrix-dense-col-sum-coo: Sparse COO Matrix Column Sums
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn sparse_coo_col_sums(out_sums: vector[float], cols: vector[int], vals: vector[float]):
    n := out_sums.len()
    i := 0
    while i < n:
        out_sums[i] = 0.0
        i = i + 1
    nnz := vals.len()
    k := 0
    while k < nnz:
        c := cols[k]
        out_sums[c] = out_sums[c] + vals[k]
        k = k + 1
