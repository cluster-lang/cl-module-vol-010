// cl-vec3-project: 3D Vector Projection of u onto v
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_project(u: vector[float], v: vector[float]) -> vector[float]:
    v_sq := v[0]*v[0] + v[1]*v[1] + v[2]*v[2]
    if v_sq <= 0.000001: return [0.0, 0.0, 0.0]
    scale := (u[0]*v[0] + u[1]*v[1] + u[2]*v[2]) / v_sq
    return [scale * v[0], scale * v[1], scale * v[2]]
