// cl-stat-similarity-jaccard-int: Test Suite
import "../jacc_int.zk"

fn test_run():
    res := jaccard_bitmask_8(255, 255)
    diff := res - 1.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-similarity-jaccard-int!")
