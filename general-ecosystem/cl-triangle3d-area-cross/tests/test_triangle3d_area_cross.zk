// cl-triangle3d-area-cross: Test Suite
import "../tri_cross.zk"

fn test_tri_cross():
    v0: vector[float] := [0.0, 0.0, 0.0]
    v1: vector[float] := [4.0, 0.0, 0.0]
    v2: vector[float] := [0.0, 3.0, 0.0]
    area := triangle3d_cross_area(v0, v1, v2)
    diff := area - 6.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test_tri_cross passed: triangle area 6.0 verified")

fn main():
    test_tri_cross()
    print("✓ All tests passed for cl-triangle3d-area-cross!")
