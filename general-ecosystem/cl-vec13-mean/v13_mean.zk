// cl-vec13-mean: 13D Vector Arithmetic Mean of Components
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec13_mean(a: vector[float]) -> float:
    s := 0.0
    i := 0
    while i < 13:
        s = s + a[i]
        i = i + 1
    return s / 13.0
