fn tri2d_centroid(ax: int, ay: int, bx: int, by: int, cx: int, cy: int) -> vector[int]:
    res: vector[int] := []
    res.push((ax + bx + cx) / 3)
    res.push((ay + by + cy) / 3)
    return res
