// cl-vec3-is-perpendicular: Check If Two 3D Vectors Are Perpendicular
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_is_perpendicular(u: vector[float], v: vector[float], eps: float) -> int:
    dot := u[0]*v[0] + u[1]*v[1] + u[2]*v[2]
    if dot < 0.0: dot = 0.0 - dot
    if dot <= eps: return 1
    return 0
