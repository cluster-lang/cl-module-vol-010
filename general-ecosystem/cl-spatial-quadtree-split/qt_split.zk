// Returns quadrant index (0: SW, 1: SE, 2: NW, 3: NE)
fn quadtree_quadrant(px: int, py: int, mid_x: int, mid_y: int) -> int:
    idx := 0
    if px >= mid_x: idx = idx + 1
    if py >= mid_y: idx = idx + 2
    return idx
