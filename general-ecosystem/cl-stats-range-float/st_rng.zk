// cl-stats-range-float: Sample Statistical Range
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn stats_range(v: vector[float]) -> float:
    n := v.len()
    if n == 0: return 0.0
    min_v := v[0]; max_v := v[0]
    i := 1
    while i < n:
        if v[i] < min_v: min_v = v[i]
        if v[i] > max_v: max_v = v[i]
        i = i + 1
    return max_v - min_v
