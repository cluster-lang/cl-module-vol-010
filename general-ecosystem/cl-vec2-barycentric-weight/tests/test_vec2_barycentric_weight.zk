// cl-vec2-barycentric-weight: Test Suite
import "../v2_bary.zk"

fn test_op():
    res := vec2_segment_param([5.0, 0.0], [0.0, 0.0], [10.0, 0.0])
    diff := float(res) - 0.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-barycentric-weight!")
