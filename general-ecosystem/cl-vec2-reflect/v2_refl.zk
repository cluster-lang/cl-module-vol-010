// cl-vec2-reflect: 2D Vector Reflection across Normal
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_reflect(v: vector[float], n: vector[float]) -> vector[float]:
    dot := v[0]*n[0] + v[1]*n[1]
    return [v[0] - 2.0 * dot * n[0], v[1] - 2.0 * dot * n[1]]
