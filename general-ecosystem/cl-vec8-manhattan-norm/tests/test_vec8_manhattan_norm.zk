// cl-vec8-manhattan-norm: Test Suite
import "../vec8_man.zk"

fn test_v8_man():
    v: vector[float] := [-3.0, -3.0, -3.0, -3.0, -3.0, -3.0, -3.0, -3.0]
    res := vec8_manhattan_norm(v)
    diff := res - 24.0
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_v8_man passed")

fn main():
    test_v8_man()
    print("✓ All tests passed for cl-vec8-manhattan-norm!")
