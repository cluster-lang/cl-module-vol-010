// cl-ts-holt-linear-trend-stage-81: Test Suite
import "../ts_ht_81.zk"

fn test_run():
    res := holt_trend_81(19.2, 18.0, 1.0, 0.1)
    diff := res - 82.6200
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
