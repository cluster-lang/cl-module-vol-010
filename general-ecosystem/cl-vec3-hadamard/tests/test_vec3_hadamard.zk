// cl-vec3-hadamard: Test Suite
import "../vec3_had.zk"

fn test_v3_had():
    a: vector[float] := [2.0, 3.0, 4.0]
    b: vector[float] := [5.0, 6.0, 7.0]
    out: vector[float] := [0.0, 0.0, 0.0]
    vec3_hadamard(out, a, b)
    if out[0] != 10.0 or out[1] != 18.0 or out[2] != 28.0: sys_exit(1)
    print("test_v3_had passed")

fn main():
    test_v3_had()
    print("✓ All tests passed for cl-vec3-hadamard!")
