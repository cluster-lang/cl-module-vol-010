// cl-stat-boltzmann-prob-stage-81: Test Suite
import "../sm_bp_81.zk"

fn test_run():
    res := boltzmann_ratio_81(10.0, 8.0, 20.0)
    diff := res - 72.9000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-boltzmann-prob-stage-81!")
