// cl-sparse-matrix-row-sum-coo: Test Suite
import "../coo_row_sum.zk"

fn test_coo_row_sum():
    r: vector[int] := [0, 0, 1, 2, 2]
    v: vector[int] := [10, 20, 5, 1, 3]
    s0 := sparse_coo_row_sum(r, v, 0)
    if s0 != 30: sys_exit(1)
    s2 := sparse_coo_row_sum(r, v, 2)
    if s2 != 4: sys_exit(1)
    print("test_coo_row_sum passed: COO row sum verified")

fn main():
    test_coo_row_sum()
    print("✓ All tests passed for cl-sparse-matrix-row-sum-coo!")
