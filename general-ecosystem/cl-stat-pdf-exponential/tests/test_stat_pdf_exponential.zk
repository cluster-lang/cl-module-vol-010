// cl-stat-pdf-exponential: Test Suite
import "../pdf_exp.zk"

fn test_run():
    res := pdf_exponential(0.0, 2.0)
    diff := res - 2.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-stat-pdf-exponential!")
