// cl-stats-normalize-minmax: Test Suite
import "../st_norm_mm.zk"

fn test_st_norm_mm():
    res := stats_minmax_scale(15.0, 10.0, 20.0)
    diff := res - 0.5
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.0001: sys_exit(1)
    print("test_st_norm_mm passed")

fn main():
    test_st_norm_mm()
    print("✓ All tests passed for cl-stats-normalize-minmax!")
