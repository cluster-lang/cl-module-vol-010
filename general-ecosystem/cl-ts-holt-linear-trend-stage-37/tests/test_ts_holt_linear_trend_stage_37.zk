// cl-ts-holt-linear-trend-stage-37: Test Suite
import "../ts_ht_37.zk"

fn test_run():
    res := holt_trend_37(19.2, 18.0, 1.0, 0.1)
    diff := res - 37.7400
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
