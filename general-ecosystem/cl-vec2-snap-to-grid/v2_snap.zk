// cl-vec2-snap-to-grid: Snap 2D Vector to Nearest Uniform Grid Cell
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec2_snap(v: vector[float], grid_size: float) -> vector[float]:
    if grid_size <= 0.0: return v
    gx := float(int((v[0] + 0.5 * grid_size) / grid_size)) * grid_size
    gy := float(int((v[1] + 0.5 * grid_size) / grid_size)) * grid_size
    return [gx, gy]
