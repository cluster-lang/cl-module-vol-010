// cl-vec2-snap-to-grid: Test Suite
import "../v2_snap.zk"

fn test_op():
    res := vec2_snap([10.4, 20.6], 10.0)
    diff0 := res[0] - 10.0000
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    diff1 := res[1] - 20.0000
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-snap-to-grid!")
