// cl-vec4-add: Test Suite
import "../vec4_add.zk"

fn test_v4_add():
    a: vector[float] := [1.0, 2.0, 3.0, 4.0]
    b: vector[float] := [5.0, 6.0, 7.0, 8.0]
    out: vector[float] := [0.0, 0.0, 0.0, 0.0]
    vec4_add(out, a, b)
    if out[0] != 6.0 or out[1] != 8.0 or out[2] != 10.0 or out[3] != 12.0: sys_exit(1)
    print("test_v4_add passed")

fn main():
    test_v4_add()
    print("✓ All tests passed for cl-vec4-add!")
