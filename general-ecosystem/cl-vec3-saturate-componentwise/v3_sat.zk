// cl-vec3-saturate-componentwise: Clamp All 3D Vector Components to Unit Interval [0, 1]
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn vec3_saturate(v: vector[float]) -> vector[float]:
    x := v[0]
    y := v[1]
    z := v[2]
    if x < 0.0: x = 0.0
    if x > 1.0: x = 1.0
    if y < 0.0: y = 0.0
    if y > 1.0: y = 1.0
    if z < 0.0: z = 0.0
    if z > 1.0: z = 1.0
    return [x, y, z]
