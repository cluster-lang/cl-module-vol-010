// cl-vec3-saturate-componentwise: Test Suite
import "../v3_sat.zk"

fn test_op():
    res := vec3_saturate([-0.5, 0.5, 1.5])
    diff0 := res[0] - 0.0000
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    diff1 := res[1] - 0.5000
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    diff2 := res[2] - 1.0000
    if diff2 < 0.0: diff2 = 0.0 - diff2
    if diff2 > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec3-saturate-componentwise!")
