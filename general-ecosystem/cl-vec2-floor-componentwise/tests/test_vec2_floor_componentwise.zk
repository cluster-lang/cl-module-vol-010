// cl-vec2-floor-componentwise: Test Suite
import "../v2_flr.zk"

fn test_op():
    res := vec2_floor([3.8, 7.1])
    diff0 := res[0] - 3.0000
    if diff0 < 0.0: diff0 = 0.0 - diff0
    if diff0 > 0.001: sys_exit(1)
    diff1 := res[1] - 7.0000
    if diff1 < 0.0: diff1 = 0.0 - diff1
    if diff1 > 0.001: sys_exit(1)
    print("test passed")

fn main():
    test_op()
    print("✓ All tests passed for cl-vec2-floor-componentwise!")
