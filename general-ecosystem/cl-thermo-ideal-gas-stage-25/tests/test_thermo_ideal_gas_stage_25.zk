// cl-thermo-ideal-gas-stage-25: Test Suite
import "../gas_pr_25.zk"

fn test_run():
    res := ideal_gas_pressure_25(1.0, 300.0, 1.0)
    diff := res - 62358.4650
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-thermo-ideal-gas-stage-25!")
