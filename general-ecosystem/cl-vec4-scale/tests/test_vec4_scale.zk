// cl-vec4-scale: Test Suite
import "../vec4_scale.zk"

fn test_v4_scale():
    v: vector[float] := [1.0, -2.0, 3.0, 4.0]
    out: vector[float] := [0.0, 0.0, 0.0, 0.0]
    vec4_scale(out, v, 2.0)
    if out[0] != 2.0 or out[1] != -4.0 or out[2] != 6.0 or out[3] != 8.0: sys_exit(1)
    print("test_v4_scale passed")

fn main():
    test_v4_scale()
    print("✓ All tests passed for cl-vec4-scale!")
