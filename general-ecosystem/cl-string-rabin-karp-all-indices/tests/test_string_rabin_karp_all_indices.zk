// cl-string-rabin-karp-all-indices: Test Suite
import "../rk_all.zk"

fn test_rk_all():
    text: vector[int] := [65, 66, 65, 66, 65] // ABABA
    pattern: vector[int] := [65, 66, 65] // ABA
    matches: vector[int] := []
    cnt := rabin_karp_all_matches(matches, text, pattern)
    // Matches at index 0 and index 2
    if cnt != 2: sys_exit(1)
    if matches[0] != 0 or matches[1] != 2: sys_exit(1)
    print("test_rk_all passed")

fn main():
    test_rk_all()
    print("✓ All tests passed for cl-string-rabin-karp-all-indices!")
