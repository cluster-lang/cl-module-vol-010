// cl-synth-fm-operator-stage-23: Test Suite
import "../syn_fm_23.zk"

fn test_run():
    res := fm_carrier_phase_23(1.5, 2.0, 0.5)
    diff := res - 57.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
