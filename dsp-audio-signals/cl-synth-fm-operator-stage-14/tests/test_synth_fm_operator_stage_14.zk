// cl-synth-fm-operator-stage-14: Test Suite
import "../syn_fm_14.zk"

fn test_run():
    res := fm_carrier_phase_14(1.5, 2.0, 0.5)
    diff := res - 35.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
