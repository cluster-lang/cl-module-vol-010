// cl-synth-adsr-envelope-decay-stage-49: Exponential ADSR Decay Segment Stage 49
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn adsr_decay_49(t: float, t_dec: float, sus: float) -> float:
    return (1.0 - (1.0 - sus) * (t / t_dec)) * 49.0
