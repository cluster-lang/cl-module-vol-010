// cl-synth-fm-operator-stage-12: Test Suite
import "../syn_fm_12.zk"

fn test_run():
    res := fm_carrier_phase_12(1.5, 2.0, 0.5)
    diff := res - 30.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-synth-fm-operator-stage-12!")
