// cl-synth-ring-mod-mix-stage-1: Test Suite
import "../syn_rm_1.zk"

fn test_run():
    res := ring_mod_1(1.0, 0.5, 0.5)
    diff := res - 0.7500
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-synth-ring-mod-mix-stage-1!")
