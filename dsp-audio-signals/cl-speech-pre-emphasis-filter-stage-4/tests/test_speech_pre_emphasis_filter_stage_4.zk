import "../sp_pe_4.zk"

fn test_run():
    res := pre_emphasis_4(10.0, 8.0, 0.95)
    diff := res - 9.6000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
