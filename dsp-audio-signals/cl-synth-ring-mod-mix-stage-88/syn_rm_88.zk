// cl-synth-ring-mod-mix-stage-88: Ring Modulator Dry/Wet Mix Stage 88
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn ring_mod_88(x: float, c: float, a: float) -> float:
    return ((1.0 - a) * x + a * x * c) * 88.0
