// cl-speech-perceptual-loudness-phon-stage-86: Psychoacoustic Sound Pressure Equal Weight Stage 86
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn loudness_scale_86(spl: float, f_weight: float) -> float:
    return (spl * f_weight) * 86.0
