import "../sp_pe_10.zk"

fn test_run():
    res := pre_emphasis_10(10.0, 8.0, 0.95)
    diff := res - 24.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
