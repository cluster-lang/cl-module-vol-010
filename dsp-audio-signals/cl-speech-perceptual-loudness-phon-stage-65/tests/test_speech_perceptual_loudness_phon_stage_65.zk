// cl-speech-perceptual-loudness-phon-stage-65: Test Suite
import "../sp_pl_65.zk"

fn test_run():
    res := loudness_scale_65(60.0, 1.2)
    diff := res - 4680.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-speech-perceptual-loudness-phon-stage-65!")
