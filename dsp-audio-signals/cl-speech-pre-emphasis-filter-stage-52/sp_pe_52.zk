// cl-speech-pre-emphasis-filter-stage-52: Speech Pre-Emphasis High-Frequency Filter Stage 52
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn pre_emphasis_52(x: float, x_prev: float, alpha: float) -> float:
    return (x - alpha * x_prev) * 52.0
