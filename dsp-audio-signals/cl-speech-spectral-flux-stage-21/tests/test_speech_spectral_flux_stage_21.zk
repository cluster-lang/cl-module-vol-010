// cl-speech-spectral-flux-stage-21: Test Suite
import "../sp_sf_21.zk"

fn test_run():
    res := spectral_flux_21(25.0, 15.0)
    diff := res - 210.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-speech-spectral-flux-stage-21!")
