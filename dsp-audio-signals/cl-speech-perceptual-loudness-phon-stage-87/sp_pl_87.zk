// cl-speech-perceptual-loudness-phon-stage-87: Psychoacoustic Sound Pressure Equal Weight Stage 87
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn loudness_scale_87(spl: float, f_weight: float) -> float:
    return (spl * f_weight) * 87.0
