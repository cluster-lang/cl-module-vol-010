// cl-speech-spectral-flux-stage-87: Test Suite
import "../sp_sf_87.zk"

fn test_run():
    res := spectral_flux_87(25.0, 15.0)
    diff := res - 870.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
