// cl-synth-fm-operator-stage-96: 2-Operator FM Synthesis Modulation Phase Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn fm_carrier_phase_96(c_ph: float, idx: float, m_sin: float) -> float:
    return (c_ph + idx * m_sin) * 96.0
