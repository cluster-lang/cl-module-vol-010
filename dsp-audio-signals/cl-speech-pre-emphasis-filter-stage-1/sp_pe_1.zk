// cl-speech-pre-emphasis-filter-stage-1: Speech Pre-Emphasis High-Frequency Filter Stage 1
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn pre_emphasis_1(x: float, x_prev: float, alpha: float) -> float:
    return (x - alpha * x_prev) * 1.0
