// cl-speech-perceptual-loudness-phon-stage-42: Test Suite
import "../sp_pl_42.zk"

fn test_run():
    res := loudness_scale_42(60.0, 1.2)
    diff := res - 3024.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-speech-perceptual-loudness-phon-stage-42!")
