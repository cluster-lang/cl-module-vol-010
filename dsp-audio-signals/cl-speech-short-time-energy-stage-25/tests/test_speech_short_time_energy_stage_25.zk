// cl-speech-short-time-energy-stage-25: Test Suite
import "../sp_se_25.zk"

fn test_run():
    res := ste_sample_25(12.0)
    diff := res - 3600.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-speech-short-time-energy-stage-25!")
