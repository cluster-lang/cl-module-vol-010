// cl-synth-chorus-delay-lfo-stage-20: Test Suite
import "../syn_ch_20.zk"

fn test_run():
    res := chorus_tap_20(20.0, 5.0, 0.8)
    diff := res - 480.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-synth-chorus-delay-lfo-stage-20!")
