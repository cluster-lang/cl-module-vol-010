import "../sp_pe_67.zk"

fn test_run():
    res := pre_emphasis_67(10.0, 8.0, 0.95)
    diff := res - 160.8000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
