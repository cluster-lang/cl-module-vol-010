// cl-synth-adsr-envelope-decay-stage-50: Test Suite
import "../syn_dc_50.zk"

fn test_run():
    res := adsr_decay_50(0.1, 0.2, 0.6)
    diff := res - 40.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-synth-adsr-envelope-decay-stage-50!")
