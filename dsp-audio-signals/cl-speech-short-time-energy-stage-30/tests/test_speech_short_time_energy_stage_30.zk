import "../sp_se_30.zk"

fn test_run():
    res := ste_sample_30(12.0)
    diff := res - 4320.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
