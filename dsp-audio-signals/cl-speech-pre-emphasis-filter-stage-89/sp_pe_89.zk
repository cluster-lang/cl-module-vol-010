// cl-speech-pre-emphasis-filter-stage-89: Speech Pre-Emphasis High-Frequency Filter Stage 89
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn pre_emphasis_89(x: float, x_prev: float, alpha: float) -> float:
    return (x - alpha * x_prev) * 89.0
