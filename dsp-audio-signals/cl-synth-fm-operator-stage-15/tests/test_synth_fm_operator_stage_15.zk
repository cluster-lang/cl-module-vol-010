// cl-synth-fm-operator-stage-15: Test Suite
import "../syn_fm_15.zk"

fn test_run():
    res := fm_carrier_phase_15(1.5, 2.0, 0.5)
    diff := res - 37.5000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-synth-fm-operator-stage-15!")
