// cl-synth-chorus-delay-lfo-stage-90: Chorus LFO Modulated Delay Tap Stage 90
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn chorus_tap_90(d0: float, w: float, lfo: float) -> float:
    return (d0 + w * lfo) * 90.0
