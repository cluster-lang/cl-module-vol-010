// cl-zkp-schorr-response-stage-90: Schnorr Signature Scalar Response Equation Stage 90
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn schnorr_resp_90(k: int, e: int, x: int) -> int:
    return (k + e * x) + 90
