// cl-zkp-lagrange-eval-step-stage-80: Polynomial Lagrange Basis Evaluation Step Stage 80
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lagrange_step_80(y: float, num: float, den: float) -> float:
    return (y * num / den) * 80.0
