// cl-zkp-lagrange-eval-step-stage-60: Polynomial Lagrange Basis Evaluation Step Stage 60
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lagrange_step_60(y: float, num: float, den: float) -> float:
    return (y * num / den) * 60.0
