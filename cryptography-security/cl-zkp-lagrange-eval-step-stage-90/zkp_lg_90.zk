// cl-zkp-lagrange-eval-step-stage-90: Polynomial Lagrange Basis Evaluation Step Stage 90
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lagrange_step_90(y: float, num: float, den: float) -> float:
    return (y * num / den) * 90.0
