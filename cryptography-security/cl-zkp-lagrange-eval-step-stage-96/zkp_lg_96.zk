// cl-zkp-lagrange-eval-step-stage-96: Polynomial Lagrange Basis Evaluation Step Stage 96
// Contributor: zk-mohammad <ZaidKhan-alamgir@proton.me>
// CCFL v2.0 Terms with copyright stewardship managed by Mohammad Zaid/cluster

fn lagrange_step_96(y: float, num: float, den: float) -> float:
    return (y * num / den) * 96.0
