// cl-zkp-lagrange-eval-step-stage-56: Test Suite
import "../zkp_lg_56.zk"

fn test_run():
    res := lagrange_step_56(5.0, 12.0, 3.0)
    diff := res - 1120.0000
    if diff < 0.0: diff = 0.0 - diff
    if diff > 0.005: sys_exit(1)
    print("test passed")

fn main():
    test_run()
    print("✓ All tests passed for cl-zkp-lagrange-eval-step-stage-56!")
